---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Workshop Tools — T-slot Wheel Truing Stand & Dishing Gauge">
  <main class="workshop">
    <header class="workshop-header">
      <a id="builder-return" href="/" class="back">← Wheel builder</a>
      <span class="eyebrow">THE WHEEL WORKSHOP / 01</span>
      <button id="print-spec" class="secondary">Print specifications</button>
    </header>
    <section class="intro">
      <div><p class="eyebrow">DESIGN • ASSEMBLE • CALIBRATE</p><h1>Build your own<br/><span>precision workshop.</span></h1><p class="intro-text">Two independent tools. Standard aluminium extrusion.<br/>Designed around the wheel you’re building.</p></div>
      <div class="wheel-card"><span class="eyebrow">YOUR WHEEL</span><strong id="wheel-name">Loading wheel…</strong><p id="wheel-source"></p><p id="wheel-summary"></p><small>Bare wheel · no tyre, cassette or rotor</small></div>
    </section>
    <p id="import-error" class="notice" hidden></p>
    <p id="storage-status" class="notice" hidden></p>
    <nav class="tool-tabs" aria-label="Workshop tool"><button data-tool="stand" aria-pressed="true"><span>01</span> Truing stand <small>Lateral + radial alignment</small></button><button data-tool="dish" aria-pressed="false"><span>02</span> Dishing gauge <small>Independent centring reference</small></button></nav>
    <div class="workbench">
      <aside class="settings panel">
        <div class="section-heading"><span class="eyebrow">CONFIGURE</span><span class="pill">mm</span></div>
        <h2>Build specification</h2>
        <label>Extrusion system<select id="profile"><option value="2020" selected>2020 · B-type · slot 6</option><option value="3030">3030 · B-type · slot 8</option><option value="4040">4040 · I-type · slot 8</option></select></label>
        <p id="profile-note" class="help"></p>
        <label>Available stock lengths<input id="stock" value="300, 400, 500, 600, 700, 800, 900, 1000"/></label><p class="help">Comma-separated lengths, 100–2000 mm. Full members only; no cutting. Valid edits update immediately.</p><output id="dish-stock-result" hidden></output>
        <label id="dish-layout-control" hidden>Dishing layout<select id="dish-layout"><option value="straight">Straight · close bridge, fixed stops</option><option value="angled">45° metal brackets · fixed rim contacts</option></select></label>
        <div id="dish-range-controls" hidden><label id="dish-stop-control">Matched stop reach<select id="dish-stop"><option value="">Auto · reusable 20 mm steps</option><option value="40">40 mm pair</option><option value="60">60 mm pair</option><option value="80">80 mm pair</option><option value="100">100 mm pair</option><option value="120">120 mm pair</option><option value="140">140 mm pair</option><option value="160">160 mm pair</option></select></label><label>Initial setup variation ± (mm)<input id="dish-allowance" type="number" min="1" max="15" step="1" value="5"/></label><p class="help">Allows for an off-centre wheel and dimensional variation when setting the centre probe. This is travel, not an accuracy tolerance.</p><output id="probe-range"></output></div>
        <label>Measurement heads<select id="measurement"><option value="pointers">Phase 1 · adjustable pointers</option><option value="dials">Phase 2 · dial upgrade</option></select></label>
        <div class="divider"></div><h3>Wheel fit</h3>
        <label>Axle interface<select id="axle"><option value="">Confirm axle interface…</option><option value="qr9">QR · 9 mm front axle</option><option value="qr10">QR · 10 mm rear axle</option><option value="12">12 mm thru axle</option><option value="15">15 mm thru axle</option><option value="20">20 mm thru axle</option></select></label>
        <div class="input-pair"><label>Left stationary end Ø (mm)<input id="seat-left" type="number" min="6" max="35" step="0.1" placeholder="Measure hub end"/></label><label>Right stationary end Ø (mm)<input id="seat-right" type="number" min="6" max="35" step="0.1" placeholder="Measure hub end"/></label></div>
        <label>Shortest usable end projection (mm)<input id="projection" type="number" min="3" max="20" step="0.1" placeholder="Measure both; use smaller"/></label>
        <label><input id="guide-rod" type="checkbox"/> Optional loose guide rod (no clamping)</label>
        <div id="dial-settings"><p class="help">Rear-lug mount: measure your dial. Face stays toward the operator.</p><label>Rear lug hole Ø (mm)<input id="lug-hole" type="number" min="5.5" max="10" step="0.1"/></label><label>Lug thickness (mm)<input id="lug-thickness" type="number" min="3" max="12" step="0.1"/></label><label>Hole centre behind case rear (mm)<input id="lug-offset" type="number" min="5" max="15" step="0.1"/></label></div>
        <p class="help">200 × 200 mm print bed: separate parts use a maximum 180 mm envelope. Short brackets attach directly to the upright slots.</p>
        <label>Hub seating-face spacing<input id="hub-width" type="number" min="70" max="250" step="0.1" placeholder="Confirm spacing in mm"/></label>
        <label>Measured rim outside diameter<input id="rim-diameter" type="number" min="250" max="850" step="0.1" placeholder="Use estimated diameter"/></label><p id="diameter-note" class="help"></p>
        <label>PLA diametral fit allowance<input id="fit" type="number" min="0" max="1" step="0.05" value="0.3"/></label><p class="help">Added to hole diameter / mating width. Print a fit coupon before making fixtures.</p>
        <button id="reset-settings" class="secondary">Reset workshop settings</button>
      </aside>
      <section class="preview panel" aria-label="3D assembly">
        <div class="preview-heading"><div><span class="eyebrow">INTERACTIVE ASSEMBLY</span><h2 id="assembly-title">Truing stand</h2></div><span class="pill">3D / LIVE</span></div>
        <div id="viewer"><div id="viewer-message">Preparing 3D assembly…</div></div>
        <div class="view-controls"><div class="camera-buttons" aria-label="Camera presets"><button data-view="iso" title="Reset isometric view">Isometric</button><button data-view="front">Front / operator</button><button data-view="side">Side</button><button data-view="top">Top</button></div><span class="gesture">Drag to orbit · scroll to zoom · right-drag to pan</span></div>
        <div class="display-controls"><label><input id="show-wheel" type="checkbox" checked/> Wheel</label><label><input id="show-dimensions" type="checkbox" checked/> Stock labels</label><label class="explode-label">Explode <input id="explode" type="range" min="0" max="1" step="0.01" value="0"/></label></div>
        <div id="stand-explainer" class="mount-explainer"><strong>Coplanar H base. Uprights on the middle rail.</strong><p>The crossbar fits between the two feet, with all three rails resting flat. Metal corner brackets join their side slots. Cyan parts are PLA. Hollow top caps seat on the upright ends and bolt into side-slot T-nuts. Integral open PLA indents carry the stationary hub ends. Simple pointer brackets bolt directly to the upright slots; the rail itself is the post. To upgrade, replace the short printed brackets and heads with dial-specific parts and rear-lug brackets; reuse the frame and compatible hardware.</p><div class="camera-buttons"><button data-focus="top-cap">Inspect axle seats</button><button data-focus="measurement-mount">Inspect probe mount</button><button data-focus="angle">Inspect brackets</button></div><div class="release-controls"><label><input id="lift-wheel" type="checkbox"/> Lift wheel out (demo)</label><button id="reverse-wheel" aria-pressed="false">Reverse wheel 180°</button></div><p id="release-note">Retract probes, remove the optional loose rod if needed, then lift and reverse. Leave top-cap and upright bolts untouched.</p></div>
        <div id="dish-explainer" class="mount-explainer" hidden><strong>Dishing gauge: two rim contacts and one hub-face probe.</strong><p id="dish-layout-note">Cyan parts are flat printed carriages and contact shoes. Silver rods are M6 adjustment screws; small silver pieces are lock nuts. Each screw passes through a visible carriage beside the extrusion. The open centre shoe clears the axle and contacts the stationary hub seating face.</p><p>Two equal rim contacts establish the reference. Set the central probe on side A, lock it, then check side B without adjusting. If the probe prevents both feet seating, start from side B instead. A 2 mm rim offset produces a 4 mm central gap with both feet seated. Fixed stops need equal reach, not an exact wheel-specific height.</p><p>Straight: fewer structural joints and simpler calibration. Angled: shorter reusable members, with extra joints to check for movement. Neither design has experimentally verified 0.2 mm repeatability.</p><div class="camera-buttons"><button data-focus="dish-foot">Inspect rim carriage</button><button data-focus="dish-center">Inspect centre carriage</button><button data-focus="probe-fork">Inspect hub-face shoe</button></div></div><div class="legend"><span><i class="silver"></i> Aluminium</span><span><i class="teal"></i> PLA fixture</span><span><i class="gold"></i> Indicator</span><span>Reference geometry · not machining CAD</span></div>
      </section>
    </div>
    <section id="fit-status" class="fit-status" aria-live="polite"></section>
    <section class="parts panel">
      <div class="section-heading"><div><span class="eyebrow">EVERY PART, ACCOUNTED FOR</span><h2>Components & stock list <span id="part-count"></span></h2></div><button id="export-csv" class="secondary">Download CSV</button></div>
      <p class="help">Select a row or a part in the model to inspect it. Quantities include only the selected tool. Dimensions are envelopes unless marked as stock.</p>
      <div id="part-detail" class="part-detail" aria-live="polite">Select a component to see its dimensions and assembly specification.</div>
      <div class="table-scroll"><table><thead><tr><th>Component</th><th>Qty</th><th>Material</th><th>Size / stock</th><th>Specification</th></tr></thead><tbody id="parts-body"></tbody></table></div>
    </section>
    <section class="panel assembly-guide"><span class="eyebrow">BED ORIENTATION & FIT</span><h2>Printing the fixtures</h2><p class="help">Use a 200 × 200 mm bed with a 180 mm part envelope. These are design previews, not sliced or test-printed files. The orientation below is part-specific: inspect overhangs, hole bridges and first-layer expansion in your slicer. Do not place removable support on measurement datums.</p><ul id="print-parts"></ul></section>
    <div class="lower-grid">
      <section class="panel assembly-guide"><span class="eyebrow">FROM STOCK TO STAND</span><h2>Assembly sequence</h2><ol id="assembly-steps"></ol><h3>Fixture & fit notes</h3><ul id="assembly-notes"></ul><p class="help">Useful references: <a href="https://www.motedis.com/en/cad-database" target="_blank" rel="noreferrer">Supplier profile drawings</a> · <a href="https://www.parktool.com/en-us/blog/repair-help/wheel-dishing-centering" target="_blank" rel="noreferrer">Dishing method</a></p></section>
      <section class="panel calibration"><span class="eyebrow">MEASURE THE JIG, TOO</span><h2>Calibration notebook</h2><p class="target">0.2 mm <span>target · verify on your assembled jig</span></p>
        <ol><li>Square the base and brace it to a rigid bench. Seat the fixed top caps fully on matched upright ends. Compare printed cradle centre heights using a straight reference and the measured hub-end diameters. Check seating and bearing play in the actual unclamped condition.</li><li>Mark a rim location. Apply the same light contact pressure each time. Check for movement in joints and PLA fixtures, including after tightening.</li><li>Remove and reseat the wheel or gauge at least three times. Measure at the same mark using feeler gauges or a dial. Record signed readings with one consistent reference.</li><li>For dials: check zero return, plunger alignment and response to a known shim. A 0.01 mm dial graduation is not 0.01 mm system accuracy.</li><li>For dishing: match both rim-contact reaches on a flat reference. Lock the probe, compare opposite hub seating faces and repeat at several rim diameters.</li></ol>
        <label>Reseat readings (mm)<input id="readings" placeholder="e.g. 0.00, 0.08, 0.04"/></label><output id="repeat-result" aria-live="polite">Enter at least three readings.</output>
        <details><summary>Wheel reversal · separate stand bias</summary><p class="help">Record the rim centre relative to the same fixed stand centre, with positive toward the same stand side. B is measured after physically reversing the wheel at the same rim mark. These are centre readings, not unconverted one-sided feeler gaps.</p><div class="input-pair"><label>Orientation A (mm)<input id="reverse-a" type="number" step="0.01"/></label><label>Reversed B (mm)<input id="reverse-b" type="number" step="0.01"/></label></div><output id="reverse-result"></output><p class="help">Bias = (A + B) / 2; wheel offset = (A − B) / 2. Reversal separates a constant stand offset; it does not cancel loose seating, bending, unequal contact pressure, non-parallel hub faces or local rim runout.</p></details>
        <details><summary>Dishing gap · estimate rim offset</summary><label>Central probe gap (mm)<input id="dish-gap" type="number" min="0" step="0.01"/></label><output id="dish-result"></output><p class="help">Offset magnitude = gap / 2 only with both rim feet seated and the central probe referencing opposite dropout faces. If a foot lifts, this formula does not apply: reverse the setup side and measure a central gap. Never reference the axle tip.</p><p id="offset-note" class="notice"></p></details>
        <label>Observations<textarea id="observations" rows="3" placeholder="Reference shim, tightening changes, seating behaviour, temperature…"></textarea></label><p class="help">Repeatability describes your assembled jig. It does not certify absolute accuracy. Recheck after moving the stand, changing holders, or a temperature change; PLA can creep.</p>
      </section>
    </div>
    <footer>WHEEL WORKSHOP <span>Dimensioned DIY designs · validate fit and calibration before use</span></footer>
    <noscript><p class="notice">JavaScript is required to calculate the assembly and component list. Enable it to configure these tools.</p></noscript>
  </main>
</Layout>
<script>
  import { initWorkshop } from '../components/workshop/workshopController';
  initWorkshop();
</script>
<style is:global>
  .workshop{--line:#263445;--muted:#90a0b4;--accent:#66e0d3;max-width:1600px;width:100%;margin:auto;padding:0 32px;color:#e8edf4;font-size:14px}
  .workshop button,.workshop input,.workshop select,.workshop textarea{font:inherit}
  .workshop button,.workshop a,.workshop input,.workshop select,.workshop textarea{outline-offset:4px}
  .workshop button:focus-visible,.workshop a:focus-visible{outline:2px solid var(--accent)}
  .workshop-header{height:86px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:16px}
  .workshop .back{color:var(--accent);text-decoration:none}.workshop .eyebrow{font:10px 'JetBrains Mono',monospace;letter-spacing:2px;color:var(--muted)}
  .workshop .intro{display:flex;justify-content:space-between;align-items:center;gap:40px;padding:48px 0 40px}.workshop h1{font-size:clamp(32px,4vw,54px);line-height:1.12;letter-spacing:-2px;margin:16px 0}.workshop h1 span{color:var(--accent)}
  .workshop .intro-text{color:var(--muted);line-height:1.8}.workshop .wheel-card{width:350px;padding:24px;border-left:2px solid var(--accent);background:#111a25}.workshop .wheel-card strong{display:block;font-size:18px;line-height:1.5;margin:12px 0}.workshop .wheel-card p{margin:6px 0;color:var(--muted)}.workshop small{font-size:11px;color:var(--muted)}
  .workshop .tool-tabs{display:flex;gap:8px;margin-bottom:20px}.workshop .tool-tabs button{background:#101722;border:1px solid var(--line);padding:18px 24px;border-radius:10px;color:#d9e1ec;text-align:left;font-weight:600;flex:1;cursor:pointer}.workshop .tool-tabs button span{color:var(--muted);margin-right:14px;font-family:monospace}.workshop .tool-tabs small{display:block;margin:6px 0 0 30px;font-weight:400}.workshop .tool-tabs button[aria-pressed=true]{border-color:#4bafa7;background:#102624}.workshop .tool-tabs button[aria-pressed=true] span{color:var(--accent)}
  .workshop .panel{border:1px solid var(--line);border-radius:12px;background:#0e1520}.workshop .workbench{display:grid;grid-template-columns:290px minmax(0,1fr);gap:20px}.workshop .settings{padding:22px}.workshop .section-heading{display:flex;justify-content:space-between;align-items:center;gap:12px}.workshop h2{font-size:20px;font-weight:600;margin:8px 0 18px;letter-spacing:-.5px}.workshop h3{font-size:15px;margin:18px 0 12px}.workshop .pill{font:10px monospace;border:1px solid var(--line);border-radius:4px;padding:5px 7px;color:var(--muted)}
  .workshop label{display:block;font-size:12px;color:#c6d1df;margin-top:16px}.workshop input:not([type=checkbox]):not([type=range]),.workshop select,.workshop textarea{width:100%;display:block;background:#080f19;color:#e1e8f1;border:1px solid #344252;border-radius:6px;padding:10px;margin-top:7px;box-sizing:border-box;min-width:0}.workshop input:focus,.workshop select:focus,.workshop textarea:focus{border-color:var(--accent)}
  .workshop .help{color:var(--muted);font-size:11px;line-height:1.7;margin-top:9px}.workshop .divider{border-top:1px solid var(--line);margin-top:20px}.workshop .secondary{padding:9px 13px;border:1px solid #405065;border-radius:6px;background:#152030;color:#dbe5f2;cursor:pointer;font-size:12px}.workshop .secondary:hover{border-color:var(--accent)}.workshop #reset-settings{margin-top:18px;width:100%}
  .workshop .preview{overflow:hidden;display:flex;flex-direction:column;min-width:0}.workshop .preview-heading{display:flex;justify-content:space-between;align-items:center;padding:22px 24px 0}.workshop #viewer{min-height:450px;flex:1;position:relative;height:550px}.workshop #viewer-message{position:absolute;inset:0;display:grid;place-items:center;padding:40px;color:var(--muted);text-align:center}.workshop #viewer-message[hidden]{display:none}
  .workshop .view-controls{padding:14px 20px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.workshop .camera-buttons{display:flex;gap:6px}.workshop .camera-buttons button{border:1px solid #364659;background:#152132;border-radius:5px;padding:7px 10px;font-size:11px;cursor:pointer}.workshop .gesture{font-size:10px;color:var(--muted)}.workshop .display-controls{display:flex;padding:0 22px 14px;align-items:center;gap:24px;flex-wrap:wrap}.workshop .display-controls label{display:flex;align-items:center;gap:8px;margin:0}.workshop input[type=checkbox],.workshop input[type=range]{accent-color:#46c8b9}.workshop .explode-label{flex:1;min-width:150px}.workshop #explode{width:100%;min-width:80px}.workshop .legend{padding:12px 22px;display:flex;gap:16px;flex-wrap:wrap;font-size:10px;color:var(--muted);border-top:1px solid var(--line);background:#101a27}.workshop .legend i{display:inline-block;width:7px;height:7px;border-radius:2px;margin-right:5px}.workshop .silver{background:#a8b6c8}.workshop .teal{background:#16b8b1}.workshop .gold{background:#f6bd60}
  .workshop .fit-status{padding:18px 22px;margin:20px 0;border:1px solid #36534e;border-radius:10px;background:#10211f;color:#b0dcd2;line-height:1.7}.workshop .fit-status.invalid,.workshop .notice{border:1px solid #795b2f;color:#e8c88f;background:#261f14}.workshop .notice{padding:12px;border-radius:6px;margin:12px 0;line-height:1.6}.workshop [hidden]{display:none!important}.workshop .fit-status ul{margin:8px 0 0 18px;list-style:disc}.workshop .parts{padding:24px}.workshop #part-count{font:12px monospace;color:var(--muted);margin-left:10px}.workshop .part-detail{margin:18px 0;padding:16px;background:#132530;border-left:2px solid #48b7ad;line-height:1.8;font-size:12px}.workshop .table-scroll{overflow:auto;max-height:540px}.workshop table{width:100%;border-collapse:collapse;text-align:left;font-size:12px}.workshop th{font:10px monospace;color:var(--muted);text-transform:uppercase;letter-spacing:1px;position:sticky;top:0;background:#15202d;padding:12px}.workshop td{padding:12px;border-bottom:1px solid #1f2b39;vertical-align:top}.workshop td:last-child{max-width:450px;font-size:11px;color:var(--muted);line-height:1.6}.workshop td:first-child{min-width:170px}.workshop td:nth-child(4){min-width:145px;font-family:monospace}.workshop .part-button{background:none;border:0;color:#d8e6f3;text-align:left;cursor:pointer;padding:0}.workshop tr.selected{background:#123132}.workshop tr.selected .part-button{color:var(--accent)}
  .workshop .lower-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0 40px}.workshop .lower-grid .panel{padding:26px;min-width:0}.workshop ol{list-style:decimal;padding-left:22px;color:#b2c0d0;font-size:12px;line-height:1.9}.workshop li{margin-bottom:12px;padding-left:5px}.workshop #assembly-notes{list-style:disc;padding-left:16px;font-size:11px;color:var(--muted);line-height:1.8}.workshop .target{font-size:28px;color:var(--accent);margin-bottom:16px}.workshop .target span{font-size:11px;color:var(--muted)}.workshop output{display:block;padding:12px;background:#12222c;color:#aad9df;font:12px monospace;line-height:1.7;margin-top:12px;border-radius:6px}.workshop output.fail{background:#302117;color:#f0bb89}.workshop details{border-top:1px solid var(--line);margin-top:18px;padding-top:16px}.workshop summary{cursor:pointer;font-size:12px;color:#d3e0ef}.workshop .input-pair{display:grid;grid-template-columns:1fr 1fr;gap:14px}.workshop a{color:var(--accent)}.workshop footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font:10px monospace;display:flex;justify-content:space-between;gap:16px}
  .workshop .mount-explainer{padding:16px 22px;background:#102322;border-top:1px solid #31514a;font-size:12px;line-height:1.7}.workshop .mount-explainer p{color:#b2c8c4;margin:8px 0}.workshop .release-controls{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:14px}.workshop .release-controls label{margin:0}.workshop #reverse-wheel{border:1px solid #40596a;border-radius:5px;padding:6px 10px;font-size:11px;cursor:pointer}
  @media(max-width:1000px){.workshop{padding:0 18px}.workshop .workbench{grid-template-columns:255px minmax(0,1fr)}.workshop .gesture{display:none}.workshop .lower-grid{grid-template-columns:1fr}.workshop h1{font-size:38px}.workshop .wheel-card{width:290px}.workshop #viewer{min-height:430px}}
  @media(max-width:700px){.workshop-header>.eyebrow{display:none}.workshop .intro{display:block;padding:28px 0}.workshop .wheel-card{width:100%;margin-top:24px}.workshop .workbench{display:flex;flex-direction:column}.workshop .preview{order:-1}.workshop #viewer{height:400px;min-height:400px;flex:auto}.workshop .tool-tabs button{padding:14px;font-size:13px}.workshop .tool-tabs small{margin-left:0;font-size:10px}.workshop .parts{padding:16px}.workshop .parts h2{font-size:17px}.workshop .section-heading{flex-wrap:wrap}.workshop .lower-grid .panel{padding:20px}.workshop .display-controls{gap:16px}.workshop footer{flex-direction:column}.workshop .intro-text br{display:none}}
  @media print{body{background:white!important;color:black!important}.workshop{max-width:none;padding:0;color:black}.workshop .workshop-header,.workshop .tool-tabs,.workshop .preview,.workshop button,.workshop .settings,.workshop footer{display:none!important}.workshop .intro{padding:10px 0}.workshop h1{font-size:26px}.workshop .intro-text{display:none}.workshop .panel,.workshop .wheel-card,.workshop .fit-status,.workshop .notice,.workshop output,.workshop .part-detail{background:white!important;color:black!important;border-color:#888}.workshop .lower-grid{display:block}.workshop .table-scroll{max-height:none;overflow:visible}.workshop table{font-size:9px}.workshop th{position:static;background:#eee;color:black}.workshop td,.workshop td:last-child,.workshop .help,.workshop li,.workshop small{color:#333}.workshop .part-button{display:block!important;color:black!important}.workshop .lower-grid .panel{margin-top:16px;break-inside:auto}.workshop tr{break-inside:avoid}.workshop h2,.workshop h3{break-after:avoid}.workshop .wheel-card{width:300px}.workshop .workbench{display:none}.workshop input,.workshop textarea{background:white!important;color:black!important}.workshop .eyebrow{color:#555}.workshop details{display:block}.workshop .part-detail{font-size:10px}.workshop #part-count{color:#333}}
</style>
