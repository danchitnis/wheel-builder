---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="A professional, state-of-the-art 3D spoke length calculator and wheel builder based on first-principles physics." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>☸️</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Custom Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=JetBrains+Mono:wght@100;300;400;500;600;700&amp;display=swap" rel="stylesheet">
  </head>
  <body class="bg-titanium-950 text-titanium-100 font-sans selection:bg-cyan-500/30 selection:text-cyan-300 overflow-x-hidden min-h-screen flex flex-col antialiased">
    <slot />
  </body>
</html>

<style is:global>
  /* Modern custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #0a0a0b;
  }
  ::-webkit-scrollbar-thumb {
    background: #2a2a2c;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #3c3c40;
  }

  body {
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  code, pre, .mono-data {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Fade-in animations */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
