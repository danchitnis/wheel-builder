---
import { rims } from '../data/rims';
import { hubs } from '../data/hubs';
---

<header class="sticky top-0 z-50 bg-titanium-950/70 backdrop-blur-xl border-b border-titanium-800/80 px-6 py-4">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative flex items-center justify-center w-10 h-10 rounded-full border border-cyan-500/30 bg-cyan-950/20 group-hover:border-cyan-400 group-hover:shadow-[0_0_15px_rgba(6,182,212,0.3)] transition-all duration-300">
        <!-- Generic Hub-and-Spoke Logo -->
        <svg class="w-6 h-6 text-cyan-400 group-hover:rotate-45 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <circle cx="12" cy="12" r="3" class="fill-cyan-950/50" />
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2v7M12 15v7M2 12h7M15 12h7M4.93 4.93l4.93 4.93M14.14 14.14l4.93 4.93M4.93 19.07l4.93-4.93M14.14 9.86l4.93-4.93" />
        </svg>
      </div>
      <div class="flex flex-col">
        <h1 class="text-xl font-bold tracking-tight bg-gradient-to-r from-titanium-50 via-titanium-100 to-cyan-400 bg-clip-text text-transparent">
          Wheel <span class="text-cyan-400 font-medium">builder</span>
        </h1>
        <p class="text-xs text-titanium-400 tracking-wider font-medium uppercase">Wheel Dimensioning Engine</p>
      </div>
    </a>

    <div class="flex flex-wrap items-center justify-end gap-3 sm:ml-auto">
      <a id="workshop-link" href="/workshop" class="text-sm text-cyan-300 border border-cyan-500/30 rounded-lg px-4 py-2 hover:bg-cyan-950/30">Workshop tools ↗</a>

      <!-- Live database counters -->
      <div class="flex items-center gap-2 sm:gap-4 text-xs">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-titanium-800 bg-titanium-900/50">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          <span class="text-titanium-400">Library:</span>
          <span class="font-bold text-titanium-200 mono-data">{rims.length} Rims</span>
          <span class="text-titanium-700">|</span>
          <span class="font-bold text-titanium-200 mono-data">{hubs.length} Hubs</span>
        </div>

        <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-950/10 text-emerald-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"></path>
          </svg>
          <span class="font-semibold tracking-wide">Geometry &amp; Path Estimates</span>
        </div>
      </div>
      <a href="https://github.com/danchitnis/wheel-builder" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-titanium-700 px-3 py-2 text-sm text-titanium-200 transition-colors hover:border-cyan-500/50 hover:text-cyan-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400" aria-label="View wheel-builder on GitHub">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .75a11.25 11.25 0 0 0-3.557 21.926c.563.105.77-.244.77-.543 0-.268-.01-.978-.016-1.92-3.132.68-3.792-1.509-3.792-1.509-.512-1.302-1.25-1.65-1.25-1.65-1.022-.698.077-.684.077-.684 1.13.08 1.725 1.16 1.725 1.16 1.004 1.722 2.634 1.224 3.276.936.102-.727.393-1.224.714-1.505-2.5-.284-5.128-1.25-5.128-5.561 0-1.229.439-2.233 1.159-3.02-.116-.285-.502-1.431.11-2.983 0 0 .944-.302 3.094 1.154A10.78 10.78 0 0 1 12 6.37c.957.005 1.922.13 2.822.38 2.148-1.456 3.09-1.154 3.09-1.154.615 1.552.229 2.698.113 2.983.722.787 1.157 1.791 1.157 3.02 0 4.322-2.633 5.273-5.14 5.551.404.35.764 1.041.764 2.098 0 1.515-.014 2.737-.014 3.109 0 .302.203.654.774.542A11.252 11.252 0 0 0 12 .75Z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
