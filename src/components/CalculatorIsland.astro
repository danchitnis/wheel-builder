  // 1. SWITCH TAB LOGIC
  function switchTab(tab: 'assembly' | 'lacing' | 'hub' | 'rim' | 'nipple') {
    clearLacingHighlight();
    const tabs = [
      { id: 'assembly', btn: btnTabAssembly, pane: paneAssembly },
      { id: 'lacing', btn: btnTabLacing, pane: paneLacing },
      { id: 'hub', btn: btnTabHub, pane: paneHub },
      { id: 'rim', btn: btnTabRim, pane: paneRim },
      { id: 'nipple', btn: btnTabNipple, pane: paneNipple },
    ];

    tabs.forEach(t => {
      t.btn.setAttribute('aria-selected', String(t.id === tab));
      t.btn.tabIndex = t.id === tab ? 0 : -1;
      if (t.id === tab) {
        t.pane.classList.remove('hidden');
        t.btn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-md');
        t.btn.classList.remove('text-titanium-400', 'hover:text-titanium-200', 'hover:bg-titanium-800/50');
      } else {
        t.pane.classList.add('hidden');
        t.btn.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-md');
        t.btn.classList.add('text-titanium-400', 'hover:text-titanium-200', 'hover:bg-titanium-800/50');
      }
    });

    // Move 3D Viewport Card into active tab's host container
    if (viewportCard) {
      if (tab === 'lacing' && lacingViewportHost && viewportCard.parentElement !== lacingViewportHost) {
        lacingViewportHost.appendChild(viewportCard);
      } else if (tab === 'assembly' && assemblyViewportHost && viewportCard.parentElement !== assemblyViewportHost) {
        assemblyViewportHost.appendChild(viewportCard);
      } else if ((tab !== 'assembly' && tab !== 'lacing') && assemblyViewportHost && viewportCard.parentElement !== assemblyViewportHost) {
        assemblyViewportHost.appendChild(viewportCard);
      }
    }

    viewportCard.classList.toggle('is-lacing', tab === 'lacing');
    const settings = document.getElementById('viewport-settings') as HTMLDetailsElement;
    if (viewport?.lacingMode !== (tab === 'lacing')) settings.open = tab !== 'lacing';
    // Toggle viewport modes
    if (viewport) {
      if (tab === 'lacing') {
        viewport.setLacingMode(true);
      } else {
        viewport.setLacingMode(false);
      }
    }

    nippleFitPanel.setVisible(tab === 'nipple');
    if (tab === 'assembly' || tab === 'lacing') void ensureViewport();
    if (tab === 'hub') void ensureHubCad().then(() => hubCad?.resize());
    if (tab === 'rim') void ensureRimCad().then(() => rimCad?.resize());

    // Handle canvas resizes when tab becomes visible
    setTimeout(() => {
      if (tab === 'hub' && hubCad) hubCad.resize();
      if (tab === 'rim' && rimCad) rimCad.resize();
      if ((tab === 'assembly' || tab === 'lacing') && viewport) window.dispatchEvent(new Event('resize'));
    }, 50);
  }

  const tabButtons = [btnTabAssembly, btnTabLacing, btnTabHub, btnTabRim, btnTabNipple];
  const tabNames = ['assembly', 'lacing', 'hub', 'rim', 'nipple'] as const;
  btnTabAssembly.parentElement!.setAttribute('role', 'tablist');
  btnTabAssembly.parentElement!.setAttribute('aria-label', 'Wheel builder views');
  tabButtons.forEach((button, index) => {
    const pane = [paneAssembly, paneLacing, paneHub, paneRim, paneNipple][index];
    button.setAttribute('role', 'tab');
    button.setAttribute('aria-controls', pane.id);
    button.setAttribute('aria-selected', String(index === 0));
    button.tabIndex = index === 0 ? 0 : -1;
    pane.setAttribute('role', 'tabpanel');
    pane.setAttribute('aria-labelledby', button.id);
    button.addEventListener('keydown', event => {
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabButtons.length - 1 : event.key === 'ArrowRight' ? (index + 1) % tabButtons.length : event.key === 'ArrowLeft' ? (index + tabButtons.length - 1) % tabButtons.length : -1;
      if (next < 0) return;
      event.preventDefault(); switchTab(tabNames[next]); tabButtons[next].focus();
    });
  });

  btnTabAssembly.addEventListener('click', () => switchTab('assembly'));
  btnTabLacing.addEventListener('click', () => switchTab('lacing'));
  btnTabHub.addEventListener('click', () => switchTab('hub'));
  btnTabRim.addEventListener('click', () => switchTab('rim'));
  btnTabNipple.addEventListener('click', () => switchTab('nipple'));

  if (btnEditHub) btnEditHub.addEventListener('click', () => switchTab('hub'));
  if (btnEditRim) btnEditRim.addEventListener('click', () => switchTab('rim'));

  // CAD Reset View buttons
  document.getElementById('btn-reset-hub-cad')?.addEventListener('click', () => hubCad?.resetView());
  document.getElementById('btn-reset-rim-cad')?.addEventListener('click', () => rimCad?.resetView());

  // 2. GATHER ALL INPUT VALUES
  function getInputs() {
    const hubOpt = hubPreset.options[hubPreset.selectedIndex];
    const hubBrand = hubOpt?.getAttribute('data-brand') || '';
    const hubName = hubOpt?.getAttribute('data-name') || 'Custom Hub';
    const hubSpacing = hubOpt?.getAttribute('data-spacing') || customHubSpacing;
    const hubDisc = (hubOpt?.getAttribute('data-disctype') as '6-Bolt' | 'Centerlock' | 'None') || customHubDisc;
    const hubTypeAttr = hubOpt?.getAttribute('data-hubtype') ?? customHubType;
    const isRear = hubTypeAttr ? hubTypeAttr === 'Rear' : (hubName.toLowerCase().includes('rear') || hubSpacing.includes('148') || hubSpacing.includes('142') || hubSpacing.includes('135') || hubSpacing.includes('157'));

    return {
      ...rimAppearance,
      nippleFit: readNippleFitSettings(),
      erd: numeric(erdIn),
      rimWidthOuter: parseFloat(woIn.value) || defaultRim.widthOuter!,
      rimWidthInner: parseFloat(wiIn.value) || defaultRim.widthInner!,
      rimDepth: parseFloat(depIn.value) || defaultRim.depth!,
      osb: parseFloat(osbIn.value) || 0.0,
      drillingOffsetLeft: parseFloat(olIn.value) || 0.0,
      drillingOffsetRight: parseFloat(orIn.value) || 0.0,
      spokeCount: numeric(countIn),
      spokeHoleDiameter: numeric(shIn),
      flangeThickness: numeric(ftlIn),
      flangeThicknessLeft: numeric(ftlIn), flangeThicknessRight: numeric(ftrIn),
      flangeOuterDiameterLeft: numeric(odlIn), flangeOuterDiameterRight: numeric(odrIn),
      spokeDiameter: numeric(sdIn), interlaced, geometryProvenance,
      hubOffset: parseFloat(hoIn.value) || 0.0,
      rimFlip: rimflipIn.value as 'Auto' | 'Left' | 'Right',
      flangePcdLeft: numeric(pcdlIn),
      centerToLeft: numeric(wlIn),
      crossesLeft: numeric(crosslIn),
      flangePcdRight: numeric(pcdrIn),
      centerToRight: numeric(wrIn),
      crossesRight: numeric(crossrIn),
      hubName: hubPreset.value === 'custom' ? 'Custom Hub' : `${hubBrand} ${hubName}`,
      spacing: hubSpacing,
      discType: hubDisc,
      isRear,
    };
  }

  let viewportState: 'idle' | 'loading' | 'ready' | 'failed' = 'idle';
  let viewportModuleLoaded = false;
  const viewportControls = Array.from(document.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLSelectElement>(
    '#viewport-camera-controls button, #viewport-settings button, #viewport-settings input, #viewport-settings select, ' +
    '#btn-prev-spoke, #btn-next-spoke, #btn-prev-group, #btn-next-group, #btn-lacing-reset, #btn-lacing-complete, #btn-lacing-return, #btn-cam-fixed, #btn-cam-autotrack',
  ));
  function setViewportState(state: typeof viewportState) {
    viewportState = state;
    const card = document.getElementById('viewport-card')!;
    card.dataset.loadState = state;
    card.setAttribute('aria-busy', String(state === 'loading'));
    document.getElementById('viewport-load-status')!.classList.toggle('hidden', state === 'ready');
    document.getElementById('viewport-retry')!.classList.toggle('hidden', state !== 'failed');
    document.getElementById('viewport-retry')!.textContent = viewportModuleLoaded ? 'Retry 3D view' : 'Reload page to retry';
    document.getElementById('viewport-load-message')!.textContent = state === 'failed'
      ? 'The 3D view could not load. Your calculations are still available. Retry, or reload the page if the problem continues.'
      : state === 'loading' ? 'Loading the 3D view…' : 'The 3D view will load when visible.';
    for (const control of viewportControls) control.disabled = state !== 'ready';
  }
  document.getElementById('viewport-retry')!.addEventListener('click', () => {
    // Browsers cache failed module evaluation/downloads for this document.
    // A new document retries the same deployment URL without unsafe cache-busting imports.
    if (!viewportModuleLoaded) {
      if (!saveCurrentBuild()) {
        // Preserve edits across the recovery reload even if tab storage is blocked.
        const recoveryUrl = new URL(window.location.href);
        recoveryUrl.hash = serializeConfiguration(captureConfiguration());
        history.replaceState(history.state, '', recoveryUrl);
      }
      window.location.reload();
      return;
    }
    setViewportState('idle');
    void ensureViewport();
  });

  async function ensureViewport(): Promise<void> {
    if (viewport || viewportState === 'failed') return;
    if (viewportLoad) return viewportLoad;
    setViewportState('loading');

    viewportLoad = import('./Viewport3D')
      .then(({ Viewport3D }) => {
        viewportModuleLoaded = true;
        const container = document.getElementById('canvas-container');
        if (!container || viewport) return;

        viewport = new Viewport3D(container);
        viewport.enableInterlacing = interlaced;
        viewport.explodedValue = Number(sliderExplode.value);
        viewport.showLeftSpokes = showLeft;
        viewport.showRightSpokes = showRight;
        viewport.colorMode = selectColorMode.value as 'classic' | 'side' | 'tension';
        syncInterlaceControl();
        viewport.setCameraPreset('isometric');
        viewport.setLacingMode(!paneLacing.classList.contains('hidden'));
        const inputs = getInputs();
        // The lacing snapshot emitted by update sets its own navigation limits.
        setViewportState('ready');
        viewport.update(inputs, calculateSpokePaths(inputs));
      })
      .catch(error => {
        viewport?.dispose();
        viewport = null;
        setViewportState('failed');
        console.error('Failed to load the 3D viewport:', error);
      })
      .finally(() => { viewportLoad = null; });

    return viewportLoad;
  }

