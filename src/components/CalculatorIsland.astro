              <span>⭕</span> Hub Flange Hole
            </span>
            <span id="lacing-flange-hole-text" class="text-xs font-bold text-titanium-100 font-mono">
              Flange Hole #1
            </span>
            <span id="lacing-heads-dir-text" class="text-[10px] text-titanium-400">
              Heads Out (Elbows In)
            </span>
          </div>

          <div class="bg-titanium-950/80 border border-emerald-500/30 rounded-xl p-3 flex flex-col gap-1">
            <span class="text-[9px] font-bold text-emerald-400 uppercase tracking-widest flex items-center gap-1">
              <span>🎯</span> Rim Bed Hole
            </span>
            <span id="lacing-rim-hole-text" class="text-xs font-bold text-titanium-100 font-mono">
              Rim Hole #1 (Valve Neighbor)
            </span>
            <span id="lacing-spoke-length-text" class="text-[10px] text-titanium-400">
              Length: -- mm
            </span>
