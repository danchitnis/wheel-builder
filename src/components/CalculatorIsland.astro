  .lacing-target-label { position: absolute; bottom: 26px; width: 160px; transform: translateX(-50%); padding: .4rem .5rem; border: 1px solid currentColor; border-radius: .5rem; color: var(--target-color); background: #090e14f5; text-align: center; font-size: 13px; line-height: 1.35; }
