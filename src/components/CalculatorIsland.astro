  let showLeft = true;
  if (toggleLSpokes) {
    toggleLSpokes.addEventListener('click', () => {
      showLeft = !showLeft;
      toggleLSpokes.classList.toggle('bg-cyan-950/30', showLeft);
      toggleLSpokes.classList.toggle('text-cyan-400', showLeft);
      toggleLSpokes.classList.toggle('bg-titanium-950', !showLeft);
      toggleLSpokes.classList.toggle('text-titanium-500', !showLeft);
      if (viewport) {
        viewport.showLeftSpokes = showLeft;
        viewport.update(getInputs());
      }
    });
  }

  let showRight = true;
  if (toggleRSpokes) {
    toggleRSpokes.addEventListener('click', () => {
      showRight = !showRight;
      toggleRSpokes.classList.toggle('bg-cyan-950/30', showRight);
      toggleRSpokes.classList.toggle('text-cyan-400', showRight);
      toggleRSpokes.classList.toggle('bg-titanium-950', !showRight);
      toggleRSpokes.classList.toggle('text-titanium-500', !showRight);
      if (viewport) {
        viewport.showRightSpokes = showRight;
        viewport.update(getInputs());
      }
    });
  }

  function syncInterlaceControl() {
    toggleInterlace.classList.toggle('bg-cyan-950/30', interlaced);
    toggleInterlace.classList.toggle('text-cyan-400', interlaced);
    toggleInterlace.classList.toggle('bg-titanium-950', !interlaced);
    toggleInterlace.classList.toggle('text-titanium-500', !interlaced);
    toggleInterlace.textContent = interlaced ? 'Interlaced · both sides' : 'Non-interlaced · both sides';
    toggleInterlace.setAttribute('aria-pressed', String(interlaced));
