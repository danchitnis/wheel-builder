        <!-- Educational Pro-Tip Guidance Box -->
        <div class="bg-titanium-950/90 border border-titanium-800/80 rounded-xl p-3.5 flex flex-col gap-1.5">
          <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1">
            <span>🧠</span> Wheelbuilder Rule & Hole Counting
          </span>
          <p id="lacing-rule-tip-text" class="text-xs text-titanium-300 leading-relaxed font-sans">
            Start by locating the Valve Hole on the rim bed (highlighted in yellow). Insert the Key Spoke (first Drive Side trailing spoke) into the hub flange, then seat it in the rim hole directly adjacent to the valve hole.
          </p>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: DEDICATED LACING 3D VIEWPORT CONTAINER -->
    <div class="flex-grow flex flex-col min-w-0">
      <div id="lacing-viewport-host" class="w-full flex-grow min-h-[480px] lg:min-h-[580px] relative rounded-2xl overflow-hidden shadow-2xl border border-titanium-800">
        <!-- ViewportCard will be mounted here when Tab 4 is active -->
      </div>
    </div>
  </div>

</div>

<script>
  import { calculateWheelBuild } from '../utils/physicsCalculator';
  import { Viewport3D } from './Viewport3D';
  import { HubCadVisualizer } from './HubCadVisualizer';
  import { RimCadVisualizer } from './RimCadVisualizer';
  import { Chart } from 'chart.js/auto';

  let viewport: Viewport3D | null = null;
  let hubCad: HubCadVisualizer | null = null;
  let rimCad: RimCadVisualizer | null = null;
  let chartInstance: Chart | null = null;

  // DOM Elements - Tabs
  const btnTabAssembly = document.getElementById('btn-tab-assembly') as HTMLButtonElement;
  const btnTabLacing = document.getElementById('btn-tab-lacing') as HTMLButtonElement;
  const btnTabHub = document.getElementById('btn-tab-hub') as HTMLButtonElement;
  const btnTabRim = document.getElementById('btn-tab-rim') as HTMLButtonElement;

  const paneAssembly = document.getElementById('tab-content-assembly') as HTMLElement;
  const paneLacing = document.getElementById('tab-content-lacing') as HTMLElement;
  const paneHub = document.getElementById('tab-content-hub') as HTMLElement;
  const paneRim = document.getElementById('tab-content-rim') as HTMLElement;

  const assemblyViewportHost = document.getElementById('assembly-viewport-host') as HTMLElement;
  const lacingViewportHost = document.getElementById('lacing-viewport-host') as HTMLElement;

  // DOM Elements - Lacing Tab Controls
  const lacingSpokeCounter = document.getElementById('lacing-spoke-counter') as HTMLElement;
  const lacingPercentLabel = document.getElementById('lacing-percent-label') as HTMLElement;
  const barOverallLacing = document.getElementById('bar-overall-lacing') as HTMLElement;

  const badgeG1Count = document.getElementById('badge-g1-count') as HTMLElement;
  const barG1 = document.getElementById('bar-g1') as HTMLElement;
  const badgeG2Count = document.getElementById('badge-g2-count') as HTMLElement;
  const barG2 = document.getElementById('bar-g2') as HTMLElement;
  const badgeG3Count = document.getElementById('badge-g3-count') as HTMLElement;
  const barG3 = document.getElementById('bar-g3') as HTMLElement;
  const badgeG4Count = document.getElementById('badge-g4-count') as HTMLElement;
  const barG4 = document.getElementById('bar-g4') as HTMLElement;

  const btnPrevSpoke = document.getElementById('btn-prev-spoke') as HTMLButtonElement;
  const btnNextSpoke = document.getElementById('btn-next-spoke') as HTMLButtonElement;
  const btnPrevGroup = document.getElementById('btn-prev-group') as HTMLButtonElement;
  const btnNextGroup = document.getElementById('btn-next-group') as HTMLButtonElement;
  const btnLacingReset = document.getElementById('btn-lacing-reset') as HTMLButtonElement;
  const btnLacingComplete = document.getElementById('btn-lacing-complete') as HTMLButtonElement;

  const btnCamFixed = document.getElementById('btn-cam-fixed') as HTMLButtonElement;
  const btnCamAutotrack = document.getElementById('btn-cam-autotrack') as HTMLButtonElement;

  const lacingSpokeTitle = document.getElementById('lacing-spoke-title') as HTMLElement;
  const lacingSpokeSideBadge = document.getElementById('lacing-spoke-side-badge') as HTMLElement;
  const lacingFlangeHoleText = document.getElementById('lacing-flange-hole-text') as HTMLElement;
  const lacingHeadsDirText = document.getElementById('lacing-heads-dir-text') as HTMLElement;
  const lacingRimHoleText = document.getElementById('lacing-rim-hole-text') as HTMLElement;
  const lacingSpokeLengthText = document.getElementById('lacing-spoke-length-text') as HTMLElement;
  const lacingRuleTipText = document.getElementById('lacing-rule-tip-text') as HTMLElement;

  // DOM Elements - Presets
  const rimPreset = document.getElementById('rim-preset') as HTMLSelectElement;
  const hubPreset = document.getElementById('hub-preset') as HTMLSelectElement;

  // DOM Elements - Summary Badges
  const summaryHubName = document.getElementById('summary-hub-name') as HTMLElement;
  const summaryRimName = document.getElementById('summary-rim-name') as HTMLElement;
  const btnEditHub = document.getElementById('btn-edit-hub') as HTMLButtonElement;
  const btnEditRim = document.getElementById('btn-edit-rim') as HTMLButtonElement;

  // DOM Elements - Inputs
  const erdIn = document.getElementById('input-erd') as HTMLInputElement;
  const woIn = document.getElementById('input-rim-wo') as HTMLInputElement;
  const wiIn = document.getElementById('input-rim-wi') as HTMLInputElement;
  const depIn = document.getElementById('input-rim-dep') as HTMLInputElement;
  const osbIn = document.getElementById('input-osb') as HTMLInputElement;
  const olIn = document.getElementById('input-ol') as HTMLInputElement;
  const orIn = document.getElementById('input-or') as HTMLInputElement;

  const pcdlIn = document.getElementById('input-pcdl') as HTMLInputElement;
  const pcdrIn = document.getElementById('input-pcdr') as HTMLInputElement;
  const wlIn = document.getElementById('input-wl') as HTMLInputElement;
  const wrIn = document.getElementById('input-wr') as HTMLInputElement;
  const shIn = document.getElementById('input-sh') as HTMLInputElement;
  const ftIn = document.getElementById('input-ft') as HTMLInputElement;
  const hoIn = document.getElementById('input-ho') as HTMLInputElement;

  const countIn = document.getElementById('input-count') as HTMLInputElement;
  const countLabel = document.getElementById('label-count') as HTMLElement;
  const crosslIn = document.getElementById('input-crossl') as HTMLSelectElement;
  const crossrIn = document.getElementById('input-crossr') as HTMLSelectElement;
  const rimflipIn = document.getElementById('input-rimflip') as HTMLSelectElement;

  // DOM Elements - Overlay / Viewport Settings
  const sliderExplode = document.getElementById('slider-explode') as HTMLInputElement;
  const explodeValLabel = document.getElementById('explode-val') as HTMLElement;
  const toggleLSpokes = document.getElementById('toggle-l-spokes') as HTMLButtonElement;
  const toggleRSpokes = document.getElementById('toggle-r-spokes') as HTMLButtonElement;
  const toggleInterlace = document.getElementById('toggle-interlace') as HTMLButtonElement;
  const toggleRuler = document.getElementById('toggle-ruler') as HTMLButtonElement;
  const selectColorMode = document.getElementById('select-colormode') as HTMLSelectElement;

  // DOM Elements - Outputs
  const outLenL = document.getElementById('out-len-l') as HTMLElement;
  const outLenLRound = document.getElementById('out-len-l-round') as HTMLElement;
  const outLenR = document.getElementById('out-len-r') as HTMLElement;
  const outLenRRound = document.getElementById('out-len-r-round') as HTMLElement;

  const outWeffL = document.getElementById('out-weff-l') as HTMLElement;
  const outWeffR = document.getElementById('out-weff-r') as HTMLElement;
  const outBracingL = document.getElementById('out-bracing-l') as HTMLElement;
  const outBracingR = document.getElementById('out-bracing-r') as HTMLElement;
  const outWrapL = document.getElementById('out-wrap-l') as HTMLElement;
  const outWrapR = document.getElementById('out-wrap-r') as HTMLElement;
  const outTotL = document.getElementById('out-tot-l') as HTMLElement;
  const outTotR = document.getElementById('out-tot-r') as HTMLElement;
  const outExitL = document.getElementById('out-exit-l') as HTMLElement;
  const outExitR = document.getElementById('out-exit-r') as HTMLElement;
  const outThetaL = document.getElementById('out-theta-l') as HTMLElement;
  const outThetaR = document.getElementById('out-theta-r') as HTMLElement;

  // Derived Hub/Rim DOM Elements
  const hubTotalFlange = document.getElementById('hub-total-flange') as HTMLElement;
  const hubFlangeRatio = document.getElementById('hub-flange-ratio') as HTMLElement;
  const hubPcdDiff = document.getElementById('hub-pcd-diff') as HTMLElement;

  const rimRadius = document.getElementById('rim-radius') as HTMLElement;
  const rimCircumference = document.getElementById('rim-circumference') as HTMLElement;
  const rimNetShift = document.getElementById('rim-net-shift') as HTMLElement;

  // DOM Elements - Balance Meters
  const tensionRatioLabel = document.getElementById('tension-ratio-label') as HTMLElement;
  const barPctL = document.getElementById('bar-pct-l') as HTMLElement;
  const barPctR = document.getElementById('bar-pct-r') as HTMLElement;
  const barFillL = document.getElementById('bar-fill-l') as HTMLElement;
  const barFillR = document.getElementById('bar-fill-r') as HTMLElement;

  // DOM Elements - Share button
  const copyUrlBtn = document.getElementById('copy-url-btn') as HTMLButtonElement;

  // DOM Elements - 3D Tooltip
  const tooltip = document.getElementById('spoke-tooltip') as HTMLElement;
  const tooltipTitle = document.getElementById('tooltip-title') as HTMLElement;
  const tooltipLength = document.getElementById('tooltip-length') as HTMLElement;
  const tooltipBracing = document.getElementById('tooltip-bracing') as HTMLElement;

  // 1. SWITCH TAB LOGIC
  function switchTab(tab: 'assembly' | 'lacing' | 'hub' | 'rim') {
    const tabs = [
      { id: 'assembly', btn: btnTabAssembly, pane: paneAssembly },
      { id: 'lacing', btn: btnTabLacing, pane: paneLacing },
      { id: 'hub', btn: btnTabHub, pane: paneHub },
      { id: 'rim', btn: btnTabRim, pane: paneRim },
    ];

    tabs.forEach(t => {
      if (t.id === tab) {
        t.pane.classList.remove('hidden');
        t.btn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-md');
        t.btn.classList.remove('text-titanium-400', 'hover:text-titanium-200', 'hover:bg-titanium-800/50');
      } else {
        t.pane.classList.add('hidden');
        t.btn.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-md');
        t.btn.classList.add('text-titanium-400', 'hover:text-titanium-200', 'hover:bg-titanium-800/50');
      }
    });

    // Move 3D Viewport Card into active tab's host container
    if (viewportCard) {
      if (tab === 'lacing' && lacingViewportHost && viewportCard.parentElement !== lacingViewportHost) {
        lacingViewportHost.appendChild(viewportCard);
      } else if (tab === 'assembly' && assemblyViewportHost && viewportCard.parentElement !== assemblyViewportHost) {
        assemblyViewportHost.appendChild(viewportCard);
      } else if ((tab === 'hub' || tab === 'rim') && assemblyViewportHost && viewportCard.parentElement !== assemblyViewportHost) {
        assemblyViewportHost.appendChild(viewportCard);
      }
    }

    // Toggle viewport modes
    if (viewport) {
      if (tab === 'lacing') {
        viewport.setLacingMode(true);
      } else {
        viewport.setLacingMode(false);
      }
    }

    // Handle canvas resizes when tab becomes visible
    setTimeout(() => {
      if (tab === 'hub' && hubCad) hubCad.resize();
      if (tab === 'rim' && rimCad) rimCad.resize();
      if ((tab === 'assembly' || tab === 'lacing') && viewport) window.dispatchEvent(new Event('resize'));
    }, 50);
  }

  btnTabAssembly.addEventListener('click', () => switchTab('assembly'));
  btnTabLacing.addEventListener('click', () => switchTab('lacing'));
  btnTabHub.addEventListener('click', () => switchTab('hub'));
  btnTabRim.addEventListener('click', () => switchTab('rim'));

  if (btnEditHub) btnEditHub.addEventListener('click', () => switchTab('hub'));
  if (btnEditRim) btnEditRim.addEventListener('click', () => switchTab('rim'));

  // CAD Reset View buttons
  document.getElementById('btn-reset-hub-cad')?.addEventListener('click', () => hubCad?.resetView());
  document.getElementById('btn-reset-rim-cad')?.addEventListener('click', () => rimCad?.resetView());

  // 2. GATHER ALL INPUT VALUES
  function getInputs() {
    const hubOpt = hubPreset.options[hubPreset.selectedIndex];
    const hubBrand = hubOpt?.getAttribute('data-brand') || '';
    const hubName = hubOpt?.getAttribute('data-name') || 'Custom Hub';
    const hubSpacing = hubOpt?.getAttribute('data-spacing') || '';
    const hubDisc = (hubOpt?.getAttribute('data-disctype') as '6-Bolt' | 'Centerlock' | 'None') || '6-Bolt';
    const hubTypeAttr = hubOpt?.getAttribute('data-hubtype');
    const isRear = hubTypeAttr ? hubTypeAttr === 'Rear' : (hubName.toLowerCase().includes('rear') || hubSpacing.includes('148') || hubSpacing.includes('142') || hubSpacing.includes('135') || hubSpacing.includes('157'));

    return {
      erd: parseFloat(erdIn.value) || 392.0,
      rimWidthOuter: parseFloat(woIn.value) || 22.5,
      rimWidthInner: parseFloat(wiIn.value) || 17.5,
      rimDepth: parseFloat(depIn.value) || 15.5,
      osb: parseFloat(osbIn.value) || 0.0,
      drillingOffsetLeft: parseFloat(olIn.value) || 0.0,
      drillingOffsetRight: parseFloat(orIn.value) || 0.0,
      spokeCount: parseInt(countIn.value) || 32,
      spokeHoleDiameter: parseFloat(shIn.value) || 2.6,
      flangeThickness: parseFloat(ftIn.value) || 3.0,
      hubOffset: parseFloat(hoIn.value) || 0.0,
      rimFlip: rimflipIn.value as 'Auto' | 'Left' | 'Right',
      flangePcdLeft: parseFloat(pcdlIn.value) || 57.0,
      centerToLeft: parseFloat(wlIn.value) || 35.0,
      crossesLeft: parseInt(crosslIn.value) || 3,
      flangePcdRight: parseFloat(pcdrIn.value) || 59.0,
      centerToRight: parseFloat(wrIn.value) || 22.6,
      crossesRight: parseInt(crossrIn.value) || 3,
      hubName: hubPreset.value === 'custom' ? 'Custom Hub' : `${hubBrand} ${hubName}`,
      spacing: hubSpacing,
      discType: hubDisc,
      isRear,
    };
  }

  // Helpers to apply preset selection to form fields
  function applyRimPreset() {
    const selectedOpt = rimPreset.options[rimPreset.selectedIndex];
    if (rimPreset.value !== 'custom' && selectedOpt) {
      if (selectedOpt.hasAttribute('data-erd')) erdIn.value = selectedOpt.getAttribute('data-erd') || '392.0';
      if (selectedOpt.hasAttribute('data-osb')) osbIn.value = selectedOpt.getAttribute('data-osb') || '0.0';
      if (selectedOpt.hasAttribute('data-ol')) olIn.value = selectedOpt.getAttribute('data-ol') || '0.0';
      if (selectedOpt.hasAttribute('data-or')) orIn.value = selectedOpt.getAttribute('data-or') || '0.0';
      if (selectedOpt.hasAttribute('data-wo')) woIn.value = selectedOpt.getAttribute('data-wo') || '22.5';
      if (selectedOpt.hasAttribute('data-wi')) wiIn.value = selectedOpt.getAttribute('data-wi') || '17.5';
      if (selectedOpt.hasAttribute('data-dep')) depIn.value = selectedOpt.getAttribute('data-dep') || '15.5';
    }
  }

  function applyHubPreset() {
    const selectedOpt = hubPreset.options[hubPreset.selectedIndex];
    if (hubPreset.value !== 'custom' && selectedOpt) {
      if (selectedOpt.hasAttribute('data-pcdl')) pcdlIn.value = selectedOpt.getAttribute('data-pcdl') || '57.0';
      if (selectedOpt.hasAttribute('data-pcdr')) pcdrIn.value = selectedOpt.getAttribute('data-pcdr') || '59.0';
      if (selectedOpt.hasAttribute('data-wl')) wlIn.value = selectedOpt.getAttribute('data-wl') || '35.0';
      if (selectedOpt.hasAttribute('data-wr')) wrIn.value = selectedOpt.getAttribute('data-wr') || '22.6';
      if (selectedOpt.hasAttribute('data-sh')) shIn.value = selectedOpt.getAttribute('data-sh') || '2.6';
      if (selectedOpt.hasAttribute('data-ft')) ftIn.value = selectedOpt.getAttribute('data-ft') || '3.0';
    }
  }

  // 3. RUN CALCULATIONS & RE-RENDER ALL VISUALIZERS
  function updateAll() {
    const inputs = getInputs();

    // Label spoke count
    if (countLabel) countLabel.textContent = inputs.spokeCount.toString();

    // Trigger math engine
    const results = calculateWheelBuild(inputs);

    // Update Numerical DOM Output
    if (outLenL) outLenL.innerHTML = `${results.left.calculatedSpokeLength.toFixed(1)}<span class="text-lg text-titanium-500 ml-1">mm</span>`;
    if (outLenLRound) outLenLRound.innerHTML = `Order: <span class="font-bold text-titanium-100 mono-data">${Math.round(results.left.calculatedSpokeLength)} mm</span>`;
    if (outLenR) outLenR.innerHTML = `${results.right.calculatedSpokeLength.toFixed(1)}<span class="text-lg text-titanium-500 ml-1">mm</span>`;
    if (outLenRRound) outLenRRound.innerHTML = `Order: <span class="font-bold text-titanium-100 mono-data">${Math.round(results.right.calculatedSpokeLength)} mm</span>`;

    if (outWeffL) outWeffL.textContent = `${results.left.effectiveFlangeDistance.toFixed(1)} mm`;
    if (outWeffR) outWeffR.textContent = `${results.right.effectiveFlangeDistance.toFixed(1)} mm`;

    if (outBracingL) outBracingL.textContent = `${results.left.bracingAngle.toFixed(1)}°`;
    if (outBracingR) outBracingR.textContent = `${results.right.bracingAngle.toFixed(1)}°`;

    if (outWrapL) outWrapL.textContent = `${results.left.wrapAngleAtRim.toFixed(1)}°`;
    if (outWrapR) outWrapR.textContent = `${results.right.wrapAngleAtRim.toFixed(1)}°`;

    if (outTotL) outTotL.textContent = `${results.left.totalAngleAtRim.toFixed(1)}°`;
    if (outTotR) outTotR.textContent = `${results.right.totalAngleAtRim.toFixed(1)}°`;

    if (outExitL) outExitL.textContent = `${results.left.flangeExitAngle.toFixed(1)}°`;
    if (outExitR) outExitR.textContent = `${results.right.flangeExitAngle.toFixed(1)}°`;

    if (outThetaL) outThetaL.textContent = `${results.left.thetaAngle.toFixed(1)}°`;
    if (outThetaR) outThetaR.textContent = `${results.right.thetaAngle.toFixed(1)}°`;

    // Derived Hub Specs
    const totalFlange = inputs.centerToLeft + inputs.centerToRight;
    const ratio = inputs.centerToLeft > 0 ? (inputs.centerToRight / inputs.centerToLeft) : 0;
    const pcdDiff = Math.abs(inputs.flangePcdLeft - inputs.flangePcdRight);

    if (hubTotalFlange) hubTotalFlange.textContent = `${totalFlange.toFixed(1)} mm`;
    if (hubFlangeRatio) hubFlangeRatio.textContent = `${ratio.toFixed(2)}`;
    if (hubPcdDiff) hubPcdDiff.textContent = `${pcdDiff.toFixed(1)} mm`;

    // Derived Rim Specs
    const rad = inputs.erd / 2;
    const circ = Math.PI * inputs.erd;
    if (rimRadius) rimRadius.textContent = `${rad.toFixed(1)} mm`;
    if (rimCircumference) rimCircumference.textContent = `${circ.toFixed(1)} mm`;
    if (rimNetShift) rimNetShift.textContent = `${inputs.osb.toFixed(1)} mm (${inputs.rimFlip})`;

    // Tension Balance Meters
    const tL = results.tensionRatioLeft;
    const tR = results.tensionRatioRight;
    if (tensionRatioLabel) tensionRatioLabel.textContent = `${tL.toFixed(0)} % : ${tR.toFixed(0)} %`;
    
    if (barPctL) barPctL.textContent = `${tL.toFixed(0)}%`;
    if (barPctR) barPctR.textContent = `${tR.toFixed(0)}%`;

    if (barFillL) barFillL.style.width = `${tL}%`;
    if (barFillR) barFillR.style.width = `${tR}%`;

    // Selected Preset Names & Summary Card Synchronizer
    const hubOpt = hubPreset.options[hubPreset.selectedIndex];
    const hubBrand = hubOpt?.getAttribute('data-brand') || '';
    const hubName = hubOpt?.getAttribute('data-name') || 'Custom Hub';
    const hubSpacing = hubOpt?.getAttribute('data-spacing') || '';

    const rimOpt = rimPreset.options[rimPreset.selectedIndex];
    const rimBrand = rimOpt?.getAttribute('data-brand') || '';
    const rimName = rimOpt?.getAttribute('data-name') || 'Custom Rim';

    if (summaryHubName) {
      summaryHubName.textContent = hubPreset.value === 'custom' 
        ? `Custom Hub (dL: ${inputs.flangePcdLeft} / dR: ${inputs.flangePcdRight})` 
        : `${hubBrand} ${hubName}`;
    }
    if (summaryRimName) {
      summaryRimName.textContent = rimPreset.value === 'custom' 
        ? `Custom Rim (ERD: ${inputs.erd}mm)` 
        : `${rimBrand} ${rimName}`;
    }

    // 1. Update 2D CAD Hub Visualizer
    if (hubCad) {
      hubCad.updateData({
        flangePcdLeft: inputs.flangePcdLeft,
        flangePcdRight: inputs.flangePcdRight,
        centerToLeft: inputs.centerToLeft,
        centerToRight: inputs.centerToRight,
        spokeHoleDiameter: inputs.spokeHoleDiameter,
        flangeThickness: inputs.flangeThickness,
        hubOffset: inputs.hubOffset,
        brand: hubBrand,
        name: hubName,
        spacing: hubSpacing,
      });
    }

    // 2. Update 2D CAD Rim Visualizer
    if (rimCad) {
      rimCad.updateData({
        erd: inputs.erd,
        osb: inputs.osb,
        drillingOffsetLeft: inputs.drillingOffsetLeft,
        drillingOffsetRight: inputs.drillingOffsetRight,
        rimWidthOuter: inputs.rimWidthOuter,
        rimWidthInner: inputs.rimWidthInner,
        rimDepth: inputs.rimDepth,
        rimFlip: inputs.rimFlip,
        brand: rimBrand,
        name: rimName,
      });
    }

    // 3. Update Three.js 3D Viewport
    if (viewport) {
      viewport.update(inputs);
    }

    // 4. Update Chart
    updateCharts(results.left.bracingAngle, results.right.bracingAngle);

    // 5. Update URL Hash
    updateHash(inputs);
  }

  // 4. CHARTS UPDATES
  function updateCharts(bracingL: number, bracingR: number) {
    const ctx = (document.getElementById('balanceChart') as HTMLCanvasElement)?.getContext('2d');
    if (!ctx) return;

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [bracingL, bracingR];
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['NDS Bracing', 'DS Bracing'],
          datasets: [{
            label: 'Bracing Angle (deg)',
            data: [bracingL, bracingR],
            backgroundColor: ['rgba(59, 130, 246, 0.45)', 'rgba(239, 68, 68, 0.45)'],
            borderColor: ['#3b82f6', '#ef4444'],
            borderWidth: 1.5,
            borderRadius: 6,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { enabled: true }
          },
          scales: {
            y: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#919299', font: { family: 'JetBrains Mono' } },
              max: 15,
              min: 0
            },
            x: {
              grid: { display: false },
              ticks: { color: '#bebfc4', font: { family: 'Space Grotesk', weight: 'bold' } }
            }
          }
        }
      });
    }
  }

  // 5. PRESETS LISTENERS
  rimPreset.addEventListener('change', () => {
    applyRimPreset();
    updateAll();
  });

  hubPreset.addEventListener('change', () => {
    applyHubPreset();
    updateAll();
  });

  // Decouple presets on manual inputs
  const manualInputs = [erdIn, woIn, wiIn, depIn, osbIn, olIn, orIn, pcdlIn, pcdrIn, wlIn, wrIn, shIn, ftIn, hoIn];
  manualInputs.forEach(elem => {
    elem.addEventListener('input', () => {
      if (elem === erdIn || elem === woIn || elem === wiIn || elem === depIn || elem === osbIn || elem === olIn || elem === orIn) {
        rimPreset.value = 'custom';
      } else {
        hubPreset.value = 'custom';
      }
      updateAll();
    });
  });

  countIn.addEventListener('input', updateAll);
  crosslIn.addEventListener('change', updateAll);
  crossrIn.addEventListener('change', updateAll);
  rimflipIn.addEventListener('change', updateAll);

  // 6. VIEWPORT DISPLAY CONTROLS
  if (sliderExplode) {
    sliderExplode.addEventListener('input', () => {
      const val = parseFloat(sliderExplode.value);
      if (explodeValLabel) explodeValLabel.textContent = `${Math.round(val * 100)}%`;
      if (viewport) {
        viewport.explodedValue = val;
        viewport.update(getInputs());
      }
    });
  }

  let showLeft = true;
  if (toggleLSpokes) {
    toggleLSpokes.addEventListener('click', () => {
      showLeft = !showLeft;
      toggleLSpokes.classList.toggle('bg-cyan-950/30', showLeft);
      toggleLSpokes.classList.toggle('text-cyan-400', showLeft);
      toggleLSpokes.classList.toggle('bg-titanium-950', !showLeft);
      toggleLSpokes.classList.toggle('text-titanium-500', !showLeft);
      if (viewport) {
        viewport.showLeftSpokes = showLeft;
        viewport.update(getInputs());
      }
    });
  }

  let showRight = true;
  if (toggleRSpokes) {
    toggleRSpokes.addEventListener('click', () => {
      showRight = !showRight;
      toggleRSpokes.classList.toggle('bg-cyan-950/30', showRight);
      toggleRSpokes.classList.toggle('text-cyan-400', showRight);
      toggleRSpokes.classList.toggle('bg-titanium-950', !showRight);
      toggleRSpokes.classList.toggle('text-titanium-500', !showRight);
      if (viewport) {
        viewport.showRightSpokes = showRight;
        viewport.update(getInputs());
      }
    });
  }

  if (toggleInterlace) {
    toggleInterlace.addEventListener('click', () => {
      if (!viewport) return;
      viewport.enableInterlacing = !viewport.enableInterlacing;
      toggleInterlace.classList.toggle('bg-cyan-950/30', viewport.enableInterlacing);
      toggleInterlace.classList.toggle('text-cyan-400', viewport.enableInterlacing);
      toggleInterlace.classList.toggle('bg-titanium-950', !viewport.enableInterlacing);
      toggleInterlace.classList.toggle('text-titanium-500', !viewport.enableInterlacing);
      toggleInterlace.textContent = viewport.enableInterlacing ? 'Interlaced' : 'Straight';
      viewport.update(getInputs());
    });
  }

  if (toggleRuler) {
    toggleRuler.addEventListener('click', () => {
      if (!viewport) return;
      viewport.showMeasurement = !viewport.showMeasurement;
      viewport.showRuler = viewport.showMeasurement;
      toggleRuler.classList.toggle('bg-yellow-950/40', viewport.showMeasurement);
      toggleRuler.classList.toggle('text-yellow-400', viewport.showMeasurement);
      toggleRuler.classList.toggle('border-yellow-500/30', viewport.showMeasurement);
      toggleRuler.classList.toggle('bg-titanium-950', !viewport.showMeasurement);
      toggleRuler.classList.toggle('text-titanium-500', !viewport.showMeasurement);
      toggleRuler.classList.toggle('border-titanium-800', !viewport.showMeasurement);
      toggleRuler.textContent = viewport.showMeasurement ? '📏 Ruler: ON' : '📏 Ruler: OFF';
      viewport.update(getInputs());
    });
  }

  if (selectColorMode) {
    selectColorMode.addEventListener('change', () => {
      if (viewport) {
        viewport.colorMode = selectColorMode.value as 'classic' | 'side' | 'tension';
        viewport.update(getInputs());
      }
    });
  }

  // Camera preset selectors
  document.querySelectorAll('.cam-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-cam') as 'isometric' | 'lateral' | 'dish' | 'hub' | 'spoke-delta';
      if (viewport) viewport.setCameraPreset(p);
    });
  });

  // Full Page Viewport Mode
  const viewportCard = document.getElementById('viewport-card') as HTMLElement;
  const btnFullpage = document.getElementById('btn-fullpage') as HTMLButtonElement;
  const fpIcon = document.getElementById('fp-icon') as HTMLElement;
  const fpLabel = document.getElementById('fp-label') as HTMLElement;

  let isFullPage = false;
  let placeholder: HTMLDivElement | null = null;
  let originalParent: HTMLElement | null = null;

  function toggleFullPage() {
    if (!viewportCard) return;
    isFullPage = !isFullPage;

    if (isFullPage) {
      originalParent = viewportCard.parentElement;
      placeholder = document.createElement('div');
      placeholder.className = 'h-[420px] sm:h-[480px] lg:h-[520px] w-full rounded-2xl border border-titanium-800/40 bg-titanium-950/20 flex items-center justify-center text-xs font-bold text-titanium-600 uppercase tracking-widest';
      placeholder.textContent = '3D Viewport in Full Page Mode';

      if (originalParent) originalParent.insertBefore(placeholder, viewportCard);
      document.body.appendChild(viewportCard);

      viewportCard.classList.add('fixed', 'inset-0', 'z-[9999]', 'w-screen', 'h-screen', 'rounded-none', 'bg-titanium-950/98', 'backdrop-blur-2xl');
      viewportCard.classList.remove('relative', 'rounded-2xl', 'h-[420px]', 'sm:h-[480px]', 'lg:h-[520px]');

      if (fpIcon) fpIcon.textContent = '✕';
      if (fpLabel) fpLabel.textContent = 'Exit Full Page';
      if (btnFullpage) {
        btnFullpage.classList.add('bg-red-950/80', 'text-red-300', 'border-red-500/50');
        btnFullpage.classList.remove('bg-cyan-950/40', 'text-cyan-300', 'border-cyan-500/30');
      }
      document.body.style.overflow = 'hidden';
    } else {
      if (originalParent && placeholder) {
        originalParent.insertBefore(viewportCard, placeholder);
        placeholder.remove();
        placeholder = null;
      }

      viewportCard.classList.remove('fixed', 'inset-0', 'z-[9999]', 'w-screen', 'h-screen', 'rounded-none', 'bg-titanium-950/98', 'backdrop-blur-2xl');
      viewportCard.classList.add('relative', 'rounded-2xl', 'h-[420px]', 'sm:h-[480px]', 'lg:h-[520px]');

      if (fpIcon) fpIcon.textContent = '🗖';
      if (fpLabel) fpLabel.textContent = 'Full Page';
      if (btnFullpage) {
        btnFullpage.classList.remove('bg-red-950/80', 'text-red-300', 'border-red-500/50');
        btnFullpage.classList.add('bg-cyan-950/40', 'text-cyan-300', 'border-cyan-500/30');
      }
      document.body.style.overflow = '';
    }

    setTimeout(() => window.dispatchEvent(new Event('resize')), 50);
  }

  if (btnFullpage) btnFullpage.addEventListener('click', toggleFullPage);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isFullPage) toggleFullPage();
  });

  // 7. RAYCAST & TOOLTIP EVENTS
  const tooltipExitBend = document.getElementById('tooltip-exitbend') as HTMLElement;
  const tooltipDirect = document.getElementById('tooltip-direct') as HTMLElement;
  const tooltipActual = document.getElementById('tooltip-actual') as HTMLElement;

  const ruler3dBadge = document.getElementById('ruler-3d-badge') as HTMLElement;
  const badgeDirectVal = document.getElementById('badge-direct-val') as HTMLElement;
  const badgeActualVal = document.getElementById('badge-actual-val') as HTMLElement;
  const badgeDeltaVal = document.getElementById('badge-delta-val') as HTMLElement;

  window.addEventListener('ruler-screen-update', (e: any) => {
    const { visible, direct3DLength, actualCurveLength } = e.detail;
    if (!ruler3dBadge) return;

    if (visible && direct3DLength > 0) {
      ruler3dBadge.classList.remove('hidden');
      if (badgeDirectVal) badgeDirectVal.textContent = `${direct3DLength.toFixed(1)} mm`;
      if (badgeActualVal) badgeActualVal.textContent = `${actualCurveLength.toFixed(1)} mm`;
      if (badgeDeltaVal) {
        const delta = actualCurveLength - direct3DLength;
        badgeDeltaVal.textContent = `${delta >= 0 ? '+' : ''}${delta.toFixed(1)} mm`;
      }
    } else {
      ruler3dBadge.classList.add('hidden');
    }
  });

  window.addEventListener('spoke-hover', (e: any) => {
    const { side, index, isLeading, length, direct3DLength, actualCurveLength, bracingAngle, flangeExitBendAngle, event } = e.detail;

    if (!tooltip) return;
    tooltip.style.left = `${event.clientX - 10}px`;
    tooltip.style.top = `${event.clientY - 170}px`;
    tooltip.classList.remove('hidden');

    if (tooltipTitle) tooltipTitle.innerHTML = `<span>${side} Side Spoke #${index + 1}</span><span class="text-[9px] px-1.5 py-0.5 rounded ${isLeading ? 'bg-cyan-950/50 text-cyan-400 border border-cyan-500/10' : 'bg-violet-950/50 text-violet-400 border border-violet-500/10'} font-bold uppercase">${isLeading ? 'Leading' : 'Trailing'}</span>`;
    if (tooltipLength) tooltipLength.textContent = `${length.toFixed(1)} mm`;
    if (tooltipDirect && direct3DLength !== undefined) tooltipDirect.textContent = `${direct3DLength.toFixed(1)} mm`;
    if (tooltipActual && actualCurveLength !== undefined) tooltipActual.textContent = `${actualCurveLength.toFixed(1)} mm`;
    if (tooltipBracing) tooltipBracing.textContent = `${bracingAngle.toFixed(1)}°`;
    if (tooltipExitBend && flangeExitBendAngle !== undefined) tooltipExitBend.textContent = `${flangeExitBendAngle.toFixed(1)}°`;
  });

  window.addEventListener('spoke-unhover', () => {
    if (tooltip) tooltip.classList.add('hidden');
  });

  // Lacing Mode UI Control Handlers
  if (btnPrevSpoke) btnPrevSpoke.addEventListener('click', () => viewport?.prevLacingSpoke());
  if (btnNextSpoke) btnNextSpoke.addEventListener('click', () => viewport?.nextLacingSpoke());
  if (btnPrevGroup) btnPrevGroup.addEventListener('click', () => viewport?.prevLacingGroup());
  if (btnNextGroup) btnNextGroup.addEventListener('click', () => viewport?.nextLacingGroup());
  if (btnLacingReset) btnLacingReset.addEventListener('click', () => viewport?.setLacingPlacedCount(0));
  if (btnLacingComplete) btnLacingComplete.addEventListener('click', () => {
    if (viewport) {
      const inputs = getInputs();
      viewport.setLacingPlacedCount(inputs.spokeCount);
    }
  });

  if (btnCamFixed) {
    btnCamFixed.addEventListener('click', () => {
      viewport?.setLacingCameraTracking(false);
      btnCamFixed.classList.add('bg-cyan-950', 'text-cyan-300', 'border', 'border-cyan-500/30');
      btnCamFixed.classList.remove('text-titanium-400');
      btnCamAutotrack?.classList.remove('bg-cyan-950', 'text-cyan-300', 'border', 'border-cyan-500/30');
      btnCamAutotrack?.classList.add('text-titanium-400');
    });
  }

  if (btnCamAutotrack) {
    btnCamAutotrack.addEventListener('click', () => {
      viewport?.setLacingCameraTracking(true);
      btnCamAutotrack.classList.add('bg-cyan-950', 'text-cyan-300', 'border', 'border-cyan-500/30');
      btnCamAutotrack.classList.remove('text-titanium-400');
      btnCamFixed?.classList.remove('bg-cyan-950', 'text-cyan-300', 'border', 'border-cyan-500/30');
      btnCamFixed?.classList.add('text-titanium-400');
    });
  }

  // Real-time listener for 'lacing-update' custom event
  window.addEventListener('lacing-update', (e: any) => {
    const { placedCount, totalSpokes, currentGroup, groupCounts, groupTotals, activeSpoke } = e.detail;

    if (lacingSpokeCounter) lacingSpokeCounter.textContent = `Spoke ${placedCount} / ${totalSpokes}`;

    const pct = Math.round((placedCount / totalSpokes) * 100);
    if (lacingPercentLabel) lacingPercentLabel.textContent = `${pct}%`;
    if (barOverallLacing) barOverallLacing.style.width = `${pct}%`;

    // Group progress badges
    if (groupCounts && groupTotals) {
      if (badgeG1Count) badgeG1Count.textContent = `${groupCounts[0]}/${groupTotals[0]}`;
      if (barG1) barG1.style.width = `${(groupCounts[0] / groupTotals[0]) * 100}%`;

      if (badgeG2Count) badgeG2Count.textContent = `${groupCounts[1]}/${groupTotals[1]}`;
      if (barG2) barG2.style.width = `${(groupCounts[1] / groupTotals[1]) * 100}%`;

      if (badgeG3Count) badgeG3Count.textContent = `${groupCounts[2]}/${groupTotals[2]}`;
      if (barG3) barG3.style.width = `${(groupCounts[2] / groupTotals[2]) * 100}%`;

      if (badgeG4Count) badgeG4Count.textContent = `${groupCounts[3]}/${groupTotals[3]}`;
      if (barG4) barG4.style.width = `${(groupCounts[3] / groupTotals[3]) * 100}%`;
    }

    // Active Group highlight styling on progress pills
    const groupBadges = [
      document.getElementById('badge-group-1'),
      document.getElementById('badge-group-2'),
      document.getElementById('badge-group-3'),
      document.getElementById('badge-group-4'),
    ];
    groupBadges.forEach((bg, idx) => {
      if (!bg) return;
      const gNum = idx + 1;
      if (gNum === currentGroup) {
        bg.classList.add('border-yellow-500/60', 'bg-yellow-950/20');
        bg.classList.remove('border-titanium-800');
      } else {
        bg.classList.remove('border-yellow-500/60', 'bg-yellow-950/20');
        bg.classList.add('border-titanium-800');
      }
    });

    // Update active spoke instruction callout card
    if (activeSpoke && placedCount > 0) {
      if (lacingSpokeTitle) lacingSpokeTitle.textContent = `Spoke #${placedCount}: ${activeSpoke.groupName}`;
      if (lacingSpokeSideBadge) {
        lacingSpokeSideBadge.textContent = `${activeSpoke.side} Side (${activeSpoke.side === 'Right' ? 'Drive' : 'Non-Drive'})`;
        lacingSpokeSideBadge.className = `text-[10px] font-mono font-bold px-2 py-0.5 rounded border ${activeSpoke.side === 'Right' ? 'bg-red-950/60 text-red-300 border-red-500/30' : 'bg-blue-950/60 text-blue-300 border-blue-500/30'}`;
      }
      if (lacingFlangeHoleText) lacingFlangeHoleText.textContent = `${activeSpoke.side} Flange Hole #${activeSpoke.flangeHoleIndex}`;
      if (lacingHeadsDirText) lacingHeadsDirText.textContent = activeSpoke.headsDir;
      if (lacingRimHoleText) lacingRimHoleText.textContent = `Rim Hole #${activeSpoke.rimHoleIndex}`;
      if (lacingSpokeLengthText) lacingSpokeLengthText.textContent = `Length: ${activeSpoke.length ? activeSpoke.length.toFixed(1) : '--'} mm`;

      // Rule Tips per Group
      if (lacingRuleTipText) {
        if (activeSpoke.group === 1) {
          lacingRuleTipText.textContent = `Group 1: Drive Side Trailing Spokes (Heads-Out). Hub Logo Alignment: Position the Hub Brand Logo facing the Valve Hole before placing Spoke #1 (Key Spoke). Place remaining spokes in every 2nd flange hole into every 4th rim hole. When complete, the spokes frame the Hub Logo directly beneath the Valve Hole!`;
        } else if (activeSpoke.group === 2) {
          lacingRuleTipText.textContent = `Group 2: Non-Drive Side Trailing Spokes (Heads-Out). Look down the axle to align left flange holes relative to the right flange. Insert trailing spokes in the left flange and seat them in the corresponding left-drilled rim holes.`;
        } else if (activeSpoke.group === 3) {
          lacingRuleTipText.textContent = `Group 3: Drive Side Leading Spokes (Heads-In). Twist the hub relative to the rim to set bracing. Insert leading spokes from inside the right flange, crossing over/under the Group 1 spokes into the remaining right-side rim holes.`;
        } else {
          lacingRuleTipText.textContent = `Group 4: Non-Drive Side Leading Spokes (Heads-In). Insert remaining leading spokes from inside the left flange, weaving over/under Group 2 spokes into the remaining left-drilled rim holes to complete the wheel assembly!`;
        }
      }
    } else {
      // 0 Spokes Placed (Bare Hub)
      if (lacingSpokeTitle) lacingSpokeTitle.textContent = `Bare Hub & Rim Setup`;
      if (lacingSpokeSideBadge) {
        lacingSpokeSideBadge.textContent = `Hub Logo & Valve Alignment`;
        lacingSpokeSideBadge.className = `text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-yellow-950/60 text-yellow-400 border border-yellow-500/30`;
      }
      if (lacingFlangeHoleText) lacingFlangeHoleText.textContent = `Flange Hole #1`;
      if (lacingHeadsDirText) lacingHeadsDirText.textContent = `Select Next Spoke`;
      if (lacingRimHoleText) lacingRimHoleText.textContent = `Rim Hole #1 (Valve Neighbor)`;
      if (lacingSpokeLengthText) lacingSpokeLengthText.textContent = `Length: -- mm`;
      if (lacingRuleTipText) {
        lacingRuleTipText.textContent = `Hub Logo Rule: Professional wheelbuilders position the Hub Brand Logo (highlighted in gold on the hub shell) directly facing the Rim Valve Hole (highlighted in yellow). Click 'Next Spoke' to place the Key Spoke so that the Hub Logo is perfectly framed through the valve hole when complete.`;
      }
    }
  });

  // 8. URL HASH SHARING
  function updateHash(inputs: ReturnType<typeof getInputs>) {
    const params = new URLSearchParams();
    for (const [key, val] of Object.entries(inputs)) {
      params.set(key, val.toString());
    }
    params.set('rp', rimPreset.value);
    params.set('hp', hubPreset.value);

    history.replaceState(null, '', `#${params.toString()}`);
  }

  function loadHash() {
    const hash = window.location.hash;
    if (!hash || hash.length < 2) return false;

    try {
      const params = new URLSearchParams(hash.substring(1));
      const rpVal = params.get('rp');
      const hpVal = params.get('hp');
      if (rpVal && rimPreset) rimPreset.value = rpVal;
      if (hpVal && hubPreset) hubPreset.value = hpVal;

      const mapField = (id: string, paramName: string) => {
        const input = document.getElementById(id) as HTMLInputElement;
        const val = params.get(paramName);
        if (input && val !== null) input.value = val;
      };

      mapField('input-erd', 'erd');
      mapField('input-rim-wo', 'rimWidthOuter');
      mapField('input-rim-wi', 'rimWidthInner');
      mapField('input-rim-dep', 'rimDepth');
      mapField('input-osb', 'osb');
      mapField('input-ol', 'ol');
      mapField('input-or', 'or');
      mapField('input-pcdl', 'flangePcdLeft');
      mapField('input-pcdr', 'flangePcdRight');
      mapField('input-wl', 'centerToLeft');
      mapField('input-wr', 'centerToRight');
      mapField('input-sh', 'spokeHoleDiameter');
      mapField('input-ft', 'flangeThickness');
      mapField('input-ho', 'hubOffset');
      mapField('input-count', 'spokeCount');
      mapField('input-crossl', 'crossesLeft');
      mapField('input-crossr', 'crossesRight');
      mapField('input-rimflip', 'rimFlip');

      return true;
    } catch (e) {
      console.warn('Failed parsing share link parameters:', e);
      return false;
    }
  }

  if (copyUrlBtn) {
    copyUrlBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);

      const originalText = copyUrlBtn.innerHTML;
      copyUrlBtn.innerHTML = `
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
        Link Copied!
      `;
      copyUrlBtn.classList.remove('bg-cyan-950/20', 'border-cyan-500/20', 'text-cyan-400');
      copyUrlBtn.classList.add('bg-emerald-950/20', 'border-emerald-500/50', 'text-emerald-400');

      setTimeout(() => {
        copyUrlBtn.innerHTML = originalText;
        copyUrlBtn.classList.add('bg-cyan-950/20', 'border-cyan-500/20', 'text-cyan-400');
        copyUrlBtn.classList.remove('bg-emerald-950/20', 'border-emerald-500/50', 'text-emerald-400');
      }, 2000);
    });
  }

  // 9. INITIALIZATION
  window.addEventListener('DOMContentLoaded', () => {
    const hasHash = loadHash();
    if (!hasHash) {
      applyHubPreset();
      applyRimPreset();
    }

    const initialInputs = getInputs();

    // Initialize 3D Viewport
    const canvasContainer = document.getElementById('canvas-container');
    if (canvasContainer) {
      viewport = new Viewport3D(canvasContainer);
      viewport.setCameraPreset('isometric');
    }

    // Initialize 2D CAD Hub Visualizer
    const hubCadContainer = document.getElementById('hub-cad-container');
    if (hubCadContainer) {
      const hubOpt = hubPreset.options[hubPreset.selectedIndex];
      hubCad = new HubCadVisualizer(hubCadContainer, {
        flangePcdLeft: initialInputs.flangePcdLeft,
        flangePcdRight: initialInputs.flangePcdRight,
        centerToLeft: initialInputs.centerToLeft,
        centerToRight: initialInputs.centerToRight,
        spokeHoleDiameter: initialInputs.spokeHoleDiameter,
        flangeThickness: initialInputs.flangeThickness,
        hubOffset: initialInputs.hubOffset,
        brand: hubOpt?.getAttribute('data-brand') || '',
        name: hubOpt?.getAttribute('data-name') || '',
        spacing: hubOpt?.getAttribute('data-spacing') || '',
      });
    }

    // Initialize 2D CAD Rim Visualizer
    const rimCadContainer = document.getElementById('rim-cad-container');
    if (rimCadContainer) {
      const rimOpt = rimPreset.options[rimPreset.selectedIndex];
      rimCad = new RimCadVisualizer(rimCadContainer, {
        erd: initialInputs.erd,
        osb: initialInputs.osb,
        drillingOffsetLeft: initialInputs.drillingOffsetLeft,
        drillingOffsetRight: initialInputs.drillingOffsetRight,
        rimWidthOuter: initialInputs.rimWidthOuter,
        rimWidthInner: initialInputs.rimWidthInner,
        rimDepth: initialInputs.rimDepth,
        rimFlip: initialInputs.rimFlip,
        brand: rimOpt?.getAttribute('data-brand') || '',
        name: rimOpt?.getAttribute('data-name') || '',
      });
    }

    // Initial Trigger
    updateAll();
  });
</script>
