---
import { rims, defaultRim } from '../data/rims';
import { hubs, defaultHub } from '../data/hubs';
import NippleFitPanel from './NippleFitPanel.astro';
---

<!-- TAB NAVIGATION BAR -->
<div class="max-w-7xl mx-auto px-4 pt-6 pb-2 w-full">
  <div class="flex items-center justify-between border-b border-titanium-800/80 pb-4 flex-wrap gap-4">
    <!-- Left: Title & Subtitle -->
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-cyan-950/60 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-bold text-lg shadow-lg">
        ⚡
      </div>
      <div>
        <h1 class="text-lg font-bold text-titanium-50 tracking-tight flex items-center gap-2">
          Wheel CAD Engine
          <span class="text-[10px] bg-cyan-950/80 text-cyan-400 border border-cyan-500/30 px-2.5 py-0.5 rounded-full font-mono uppercase tracking-wider">2D CAD & 3D</span>
        </h1>
        <p class="text-xs text-titanium-400">High-Fidelity Bicycle Wheel Geometry & Technical Cross-Section Inspector</p>
      </div>
    </div>

    <!-- Right: Navigation Tabs -->
    <div class="flex items-center bg-titanium-900/90 border border-titanium-800 p-1.5 rounded-2xl gap-1 shadow-2xl backdrop-blur-md flex-wrap">
      <button id="btn-tab-assembly" class="tab-btn active px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 shadow-md">
        <span>🎡</span>
        <span>Wheel Assembly (3D)</span>
      </button>

      <button id="btn-tab-lacing" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-titanium-400 hover:text-titanium-200 hover:bg-titanium-800/50">
        <span>🔧</span>
        <span>Interactive Lacing</span>
      </button>

      <button id="btn-tab-hub" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-titanium-400 hover:text-titanium-200 hover:bg-titanium-800/50">
        <span>⚙️</span>
        <span>Hub Config (2D)</span>
      </button>

      <button id="btn-tab-rim" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-titanium-400 hover:text-titanium-200 hover:bg-titanium-800/50">
        <span>⭕</span>
        <span>Rim Config (2D)</span>
      </button>

      <button id="btn-tab-nipple" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-titanium-400 hover:text-titanium-200 hover:bg-titanium-800/50">
        <span>🔩</span>
        <span>Nipple Config (3D)</span>
      </button>
    </div>
  </div>
</div>

<!-- MAIN TABBED CONTENT AREA -->
<div class="max-w-7xl mx-auto px-4 py-4 flex-grow flex flex-col w-full">
  <p id="build-import-error" role="alert" class="hidden mb-4 rounded-xl border border-amber-500/40 bg-amber-950/30 p-3 text-sm text-amber-200"></p>

  <!-- ================= TAB 1: WHEEL ASSEMBLY & 3D ENGINE ================= -->
  <div id="tab-content-assembly" class="tab-pane flex flex-col lg:flex-row gap-8 w-full">
    <!-- LEFT COLUMN: CONTROLS -->
    <div class="w-full lg:w-[440px] flex-shrink-0 flex flex-col gap-6 lg:max-h-[calc(100vh-160px)] lg:overflow-y-auto pr-0 lg:pr-2">
      
      <!-- Active Selected Components Summary Card -->
      <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-5 shadow-xl animate-fade-in flex flex-col gap-3">
        <div class="flex items-center justify-between border-b border-titanium-800 pb-2">
          <div class="flex items-center gap-2">
            <span class="text-cyan-400">🧩</span>
            <h2 class="text-xs font-bold text-titanium-50 uppercase tracking-wider">Selected Components</h2>
          </div>
          <span class="text-[10px] text-titanium-500 font-mono">Synced Across Tabs</span>
        </div>

        <div class="flex flex-col gap-2.5">
          <!-- Hub Summary -->
          <div class="bg-titanium-950/60 border border-titanium-800/60 rounded-xl p-3 flex items-center justify-between gap-2">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-[10px] font-bold text-titanium-400 uppercase tracking-wider">Hub Model</span>
              <span id="summary-hub-name" class="text-xs font-bold text-cyan-300 truncate mono-data">{defaultHub.brand} {defaultHub.name}</span>
            </div>
            <button id="btn-edit-hub" class="px-2.5 py-1 bg-cyan-950/40 hover:bg-cyan-900/40 border border-cyan-500/30 text-cyan-400 text-[11px] font-bold rounded-lg transition-all flex-shrink-0">
              ⚙️ Config
            </button>
          </div>

          <!-- Rim Summary -->
          <div class="bg-titanium-950/60 border border-titanium-800/60 rounded-xl p-3 flex items-center justify-between gap-2">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-[10px] font-bold text-titanium-400 uppercase tracking-wider">Rim Model</span>
              <span id="summary-rim-name" class="text-xs font-bold text-cyan-300 truncate mono-data">{defaultRim.brand} {defaultRim.name}</span>
            </div>
            <button id="btn-edit-rim" class="px-2.5 py-1 bg-cyan-950/40 hover:bg-cyan-900/40 border border-cyan-500/30 text-cyan-400 text-[11px] font-bold rounded-lg transition-all flex-shrink-0">
              ⭕ Config
            </button>
          </div>
        </div>
      </div>

      <!-- Wheel Assembly Lacing Card -->
      <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-5 shadow-xl animate-fade-in" style="animation-delay: 0.1s;">
        <div class="flex items-center gap-2.5 mb-5">
          <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
          </svg>
          <h2 class="text-base font-bold text-titanium-50 uppercase tracking-wider">Assembly Parameters</h2>
        </div>

        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <div class="flex justify-between items-center text-xs text-titanium-400">
              <label class="font-medium">Total Spoke Count (N)</label>
              <span id="label-count" class="font-bold text-titanium-100 bg-titanium-950 px-2.5 py-0.5 rounded border border-titanium-800 mono-data">32</span>
            </div>
            <input type="range" id="input-count" min="16" max="40" step="4" value="32" class="w-full accent-cyan-500 h-1.5 bg-titanium-950 rounded-lg appearance-none cursor-pointer border border-titanium-800" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Left crosses</label>
              <select id="input-crossl" class="bg-titanium-950 border border-titanium-800 rounded-lg px-2.5 py-2 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none cursor-pointer">
                <option value="0">Radial (0x)</option>
                <option value="1">1 Cross (1x)</option>
                <option value="2" selected="selected">2 Crosses (2x)</option>
                <option value="3">3 Crosses (3x)</option>
                <option value="4">4 Crosses (4x)</option>
              </select>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Right crosses</label>
              <select id="input-crossr" class="bg-titanium-950 border border-titanium-800 rounded-lg px-2.5 py-2 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none cursor-pointer">
                <option value="0">Radial (0x)</option>
                <option value="1">1 Cross (1x)</option>
                <option value="2" selected="selected">2 Crosses (2x)</option>
                <option value="3">3 Crosses (3x)</option>
                <option value="4">4 Crosses (4x)</option>
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-titanium-400">Asymmetric Rim Orientation (Rim Flip)</label>
            <select id="input-rimflip" class="bg-titanium-950 border border-titanium-800 rounded-lg px-2.5 py-2 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none cursor-pointer">
              <option value="Auto" selected="selected">Auto-Balance Tension</option>
              <option value="Left">Orient Left (Standard)</option>
              <option value="Right">Orient Right (Flipped)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Share Configuration Card -->
      <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-4 shadow-xl animate-fade-in flex items-center justify-between gap-3">
        <div class="flex flex-col gap-0.5">
          <span class="text-xs font-bold text-titanium-50 uppercase tracking-wide">Share Build</span>
          <span class="text-[10px] text-titanium-500">Remembered in this tab · copy a link to share</span>
        </div>
        <button id="copy-url-btn" class="flex items-center gap-1.5 px-3 py-1.5 bg-cyan-950/20 hover:bg-cyan-900/30 border border-cyan-500/20 hover:border-cyan-500/50 text-cyan-400 hover:text-cyan-300 text-xs font-bold rounded-xl transition-all">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
          </svg>
          Copy Link
        </button>
      </div>
      <div id="share-link-fallback" class="hidden rounded-xl border border-titanium-800 p-3">
        <label for="share-link-value" class="text-xs text-titanium-300">Copy this build link:</label>
        <input id="share-link-value" type="text" readonly class="w-full mt-2 bg-titanium-950 text-titanium-100 p-2 rounded" />
      </div>
      <p id="share-status" role="status" class="text-xs text-titanium-300"></p>
    </div>

    <!-- RIGHT COLUMN: 3D VIEWPORT & OUTCOMES -->
    <div class="flex-grow flex flex-col gap-6 animate-fade-in" style="animation-delay: 0.15s;">
      <!-- 3D Viewport Host Container -->
      <div id="assembly-viewport-host" class="w-full flex-grow flex flex-col">
        <!-- 3D Viewport Box -->
        <div id="viewport-card" class="relative bg-titanium-900/40 border border-titanium-850 rounded-2xl h-[420px] sm:h-[480px] lg:h-[520px] overflow-hidden shadow-2xl flex flex-col transition-[background-color,border-color,box-shadow] duration-300">
        <!-- 3D Canvas Container -->
        <p id="lacing-viewing-side" class="text-xs px-3 py-2 text-cyan-200 bg-titanium-950 shrink-0"></p>
        <div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing"></div>
        <div id="viewport-load-status" class="absolute inset-0 z-30 flex flex-col items-center justify-center gap-3 bg-titanium-950/90 p-6 text-center">
          <p id="viewport-load-message" role="status" class="text-sm text-titanium-200">The 3D view will load when visible.</p>
          <button id="viewport-retry" type="button" class="hidden guide-button guide-primary">Retry 3D view</button>
        </div>

        <!-- Fixed 3D Measurement HUD Panel (Top-Left) -->
        <div id="ruler-3d-badge" class="absolute top-4 left-4 hidden bg-titanium-950/85 backdrop-blur-md border border-cyan-500/40 p-3 rounded-xl shadow-2xl text-xs flex flex-col gap-1.5 z-20 pointer-events-none select-none min-w-[210px]">
          <div class="flex items-center gap-1.5 font-bold text-cyan-400 border-b border-titanium-800 pb-1">
            <span>📏 3D Vector Measurement</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-titanium-400">Matching shaft chord:</span>
            <span id="badge-direct-val" class="font-bold text-cyan-300 mono-data">-- mm</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-titanium-400">Estimated 3D shaft path:</span>
            <span id="badge-actual-val" class="font-bold text-yellow-400 mono-data">-- mm</span>
          </div>
          <div class="flex justify-between gap-4 border-t border-titanium-800/80 pt-1">
            <span class="text-titanium-400 font-medium">Extra path from bends:</span>
            <span id="badge-delta-val" class="font-bold text-emerald-400 mono-data">+-- mm</span>
          </div>
        </div>

        <!-- Hover Tooltip -->
        <div id="spoke-tooltip" class="absolute hidden bg-titanium-950/90 backdrop-blur-md border border-cyan-500/30 p-3 rounded-xl shadow-2xl text-xs flex flex-col gap-1 pointer-events-none z-30 min-w-[180px]">
          <div id="tooltip-title" class="font-bold text-cyan-400 flex items-center justify-between gap-2 border-b border-titanium-800 pb-1">
            <span>Spoke</span>
          </div>
          <div class="flex justify-between gap-4 mt-1">
            <span class="text-titanium-500">Traditional length:</span>
            <span id="tooltip-length" class="font-bold text-titanium-100 mono-data">-- mm</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-titanium-500">Matching shaft chord:</span>
            <span id="tooltip-direct" class="font-bold text-cyan-400 mono-data">-- mm</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-titanium-500">Estimated 3D shaft path:</span>
            <span id="tooltip-actual" class="font-bold text-yellow-400 mono-data">-- mm</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-titanium-500">Bracing Angle:</span>
            <span id="tooltip-bracing" class="font-semibold text-titanium-100 mono-data">--°</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-titanium-500">Exit Bend Angle:</span>
            <span id="tooltip-exitbend" class="font-semibold text-cyan-400 mono-data">--°</span>
          </div>
        </div>

        <!-- Camera Overlay controls -->
        <div id="viewport-camera-controls" class="absolute bottom-4 left-4 flex flex-wrap gap-2 z-20">
          <p class="w-full text-xs rounded-lg bg-titanium-950/90 px-2 py-1" aria-label="Spoke head and elbow colours: cyan means heads-out, green means heads-in. Outside is away from the wheel centre."><span class="text-cyan-300">Cyan: heads-out</span> · <span class="text-emerald-300">Green: heads-in</span> <span class="text-titanium-300">(head / elbow)</span></p>
          <button id="btn-reset-instruction-view" type="button" class="guide-button guide-primary" title="Restore the camera for this instruction without changing your step">Reset instruction view</button>
          <button data-cam="isometric" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Iso</button>
          <button data-cam="lateral" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Side (Lacing)</button>
          <button data-cam="dish" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Dish (Alignment)</button>
          <button data-cam="hub" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Hub</button>
          <button data-cam="spoke-delta" class="cam-btn px-2.5 py-1.5 bg-yellow-950/40 border border-yellow-500/30 text-[11px] font-bold text-yellow-300 rounded-lg hover:text-yellow-100 hover:border-yellow-400 transition-all" title="Highlight single spoke path delta (Straight chord and estimated bend path)">🔬 Spoke Delta</button>
          <button id="btn-fullpage" class="px-2.5 py-1.5 bg-cyan-950/40 border border-cyan-500/30 text-[11px] font-bold text-cyan-300 rounded-lg hover:text-cyan-100 hover:border-cyan-400 transition-all flex items-center gap-1.5" title="Expand 3D Viewport to Full Page">
            <span id="fp-icon">🗖</span>
            <span id="fp-label">Full Page</span>
          </button>
        </div>

        <!-- Settings Overlay controls -->
        <details id="viewport-settings" open class="absolute top-4 right-4 z-20 max-w-[200px]"><summary class="text-xs cursor-pointer">View settings</summary><div class="flex flex-col gap-2.5 items-end">
          <!-- Exploded Slider -->
          <div id="explode-control" class="flex flex-col gap-1 px-3 py-2 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 rounded-xl w-full">
            <div class="flex justify-between text-[10px] font-bold text-titanium-400">
              <span>EXPLODE HUB</span>
              <span id="explode-val" class="mono-data">0%</span>
            </div>
            <input type="range" id="slider-explode" aria-label="Explode hub" min="0" max="1" step="0.05" value="0" class="w-full h-1 bg-titanium-900 rounded appearance-none cursor-pointer accent-cyan-500" />
          </div>

          <!-- Visibility / Color / Interlacing / Ruler Selects -->
          <div class="flex flex-wrap gap-1 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 p-1 rounded-xl">
            <button id="toggle-l-spokes" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-cyan-950/30 text-cyan-400 border border-cyan-500/20 hover:border-cyan-500/50 transition-all">Left</button>
            <button id="toggle-r-spokes" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-cyan-950/30 text-cyan-400 border border-cyan-500/20 hover:border-cyan-500/50 transition-all">Right</button>
            <button id="toggle-interlace" aria-pressed="false" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-titanium-950 text-titanium-500 border border-cyan-500/20 hover:border-cyan-500/50 transition-all" title="Interlace at the outermost crossing on both crossed sides; radial sides have no weave">Non-interlaced · both sides</button>
            <button id="toggle-ruler" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-yellow-950/40 text-yellow-400 border border-yellow-500/30 hover:border-yellow-500/60 transition-all" title="Toggle Direct 3D Straight Measurement Vector Ruler">📏 Ruler</button>
            <select id="select-colormode" aria-label="Spoke colour mode" class="bg-titanium-950 border border-titanium-800 rounded-lg text-[10px] font-bold px-1 py-1 text-titanium-200 cursor-pointer focus:outline-none">
              <option value="classic">Titanium Steel</option>
              <option value="side">Side Colors</option>
              <option value="tension">Tension Guide</option>
            </select>
          </div>
        </div>

        </details>
        <!-- Quick help text -->
        <div id="viewport-help" class="absolute bottom-4 right-4 pointer-events-none select-none text-[10px] text-titanium-500 font-semibold uppercase tracking-widest hidden md:block">
          Drag to Rotate • Scroll to Zoom • Hover Spoke to Measure
        </div>
      </div>
    </div>

      <!-- CALCULATIONS GRID & ANALYTICS -->
      <div class="grid grid-cols-1 2xl:grid-cols-2 gap-6">
        <!-- Side-by-Side Outputs Table -->
        <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-5 shadow-xl">
          <h2 class="text-sm font-bold text-titanium-50 uppercase tracking-wider mb-4 border-b border-titanium-800 pb-2 flex justify-between">
            <span>Engine Output Metrics</span>
            <span class="text-xs font-semibold text-cyan-400 lowercase italic">Calculated</span>
          </h2>

          <div class="flex flex-col gap-4">
            <!-- Spoke Length Primary display -->
            <div class="grid grid-cols-2 gap-4">
              <!-- Left Side Length Card -->
              <div class="bg-titanium-950/50 border border-blue-500/10 p-3.5 rounded-xl flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-blue-400 uppercase tracking-wider" data-side-label="left-length">Left / non-drive — traditional</span>
                <span id="out-len-l" class="text-3xl font-bold text-titanium-50 tracking-tight mono-data">--<span class="text-lg text-titanium-500 ml-1">mm</span></span>
                <span id="out-len-l-round" class="text-xs text-titanium-400">Nearest whole millimetre: <span class="font-bold mono-data">-- mm</span></span>
              </div>

              <!-- Right Side Length Card -->
              <div class="bg-titanium-950/50 border border-red-500/10 p-3.5 rounded-xl flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-red-400 uppercase tracking-wider" data-side-label="right-length">Right / drive — traditional</span>
                <span id="out-len-r" class="text-3xl font-bold text-titanium-50 tracking-tight mono-data">--<span class="text-lg text-titanium-500 ml-1">mm</span></span>
                <span id="out-len-r-round" class="text-xs text-titanium-400">Nearest whole millimetre: <span class="font-bold mono-data">-- mm</span></span>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-xs text-left"><caption class="text-left text-cyan-300 font-bold mb-2">Estimated 3D path — millimetres</caption>
                <thead class="text-titanium-400"><tr><th class="py-2">Spoke group</th><th>3D shaft</th><th>Extra from bends</th><th>Traditional + allowance</th></tr></thead>
                <tbody id="path-results" class="mono-data text-titanium-100"></tbody>
              </table>
            </div>
            <p class="text-xs text-titanium-400">The bend allowance compares the shaft path with its own straight chord, excluding the manufactured J-bend. Head and elbow seating against the flange are not simulated. These are geometric estimates, not validated purchase lengths. Final stock length depends on measured ERD and nipple engagement.</p>
            <p id="path-errors" role="status" class="text-xs text-amber-300"></p>

            <details id="input-sensitivity" class="rounded-xl border border-titanium-800 p-3 text-xs">
              <summary class="cursor-pointer font-bold text-cyan-300 py-1">Input sensitivity</summary>
              <p id="input-sensitivity-help" class="text-titanium-400 mt-3">Change in traditional spoke length when one input increases by 1 mm. Includes offsets and Auto rim orientation. These are input responses, not measurement tolerances or confidence intervals.</p>
              <div class="overflow-x-auto mt-3">
                <table class="w-full text-left" aria-describedby="input-sensitivity-help">
                  <caption class="text-left text-titanium-300 mb-2">Length change (mm) for +1 mm input</caption>
