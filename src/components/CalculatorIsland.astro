---
import { rims } from '../data/rims';
import { hubs } from '../data/hubs';
---

<div class="max-w-7xl mx-auto px-4 py-6 flex-grow flex flex-col lg:flex-row gap-8">
  <!-- LEFT COLUMN: CONTROLS (Scrollable on large screens) -->
  <div class="w-full lg:w-[460px] flex-shrink-0 flex flex-col gap-6 lg:max-h-[calc(100vh-140px)] lg:overflow-y-auto pr-0 lg:pr-2">
    <!-- Preset Selection Card -->
    <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-5 shadow-xl animate-fade-in">
      <div class="flex items-center gap-2.5 mb-4">
        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
        </svg>
        <h2 class="text-base font-bold text-titanium-50 uppercase tracking-wider">Presets Library</h2>
      </div>

      <div class="flex flex-col gap-4">
        <!-- Rim Select -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-titanium-400 uppercase tracking-wider">Select Rim Preset</label>
          <select id="rim-preset" class="w-full bg-titanium-950 border border-titanium-800 rounded-xl px-3 py-2.5 text-sm text-titanium-100 hover:border-titanium-700 focus:border-cyan-500 focus:outline-none transition-all cursor-pointer">
            <option value="custom">Custom / Manual Rim Specs</option>
            {rims.map(r => (
              <option value={r.id} data-erd={r.erd} data-osb={r.osb} data-ol={r.drillingOffsetLeft} data-or={r.drillingOffsetRight}>
                {r.brand} - {r.name} ({r.category})
              </option>
            ))}
          </select>
        </div>

        <!-- Hub Select -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-titanium-400 uppercase tracking-wider">Select Hub Preset</label>
          <select id="hub-preset" class="w-full bg-titanium-950 border border-titanium-800 rounded-xl px-3 py-2.5 text-sm text-titanium-100 hover:border-titanium-700 focus:border-cyan-500 focus:outline-none transition-all cursor-pointer">
            <option value="custom">Custom / Manual Hub Specs</option>
            {hubs.map(h => (
              <option value={h.id} data-pcdl={h.flangePcdLeft} data-pcdr={h.flangePcdRight} data-wl={h.centerToLeft} data-wr={h.centerToRight} data-sh={h.spokeHoleDiameter}>
                {h.brand} - {h.name} ({h.spacing})
              </option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- Main Build Parameters Card -->
    <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-5 shadow-xl animate-fade-in" style="animation-delay: 0.1s;">
      <div class="flex items-center gap-2.5 mb-5">
        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
        </svg>
        <h2 class="text-base font-bold text-titanium-50 uppercase tracking-wider">Manual Specifications</h2>
      </div>

      <!-- Tabs or Form Sections -->
      <div class="flex flex-col gap-6">
        <!-- 1. RIM SPECS -->
        <div class="flex flex-col gap-4 border-b border-titanium-800/50 pb-5">
          <h3 class="text-xs font-bold text-cyan-400 tracking-widest uppercase">Rim Geometry</h3>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">ERD (mm)</label>
              <input type="number" id="input-erd" step="0.1" value="601.0" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Asymmetric OSB (mm)</label>
              <input type="number" id="input-osb" step="0.1" value="0.0" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">NDS Drilling Offset</label>
              <input type="number" id="input-ol" step="0.1" value="0.0" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">DS Drilling Offset</label>
              <input type="number" id="input-or" step="0.1" value="0.0" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
          </div>
        </div>

        <!-- 2. HUB SPECS -->
        <div class="flex flex-col gap-4 border-b border-titanium-800/50 pb-5">
          <h3 class="text-xs font-bold text-cyan-400 tracking-widest uppercase">Hub Geometry</h3>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Left Flange PCD (dL)</label>
              <input type="number" id="input-pcdl" step="0.1" value="58.0" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Right Flange PCD (dR)</label>
              <input type="number" id="input-pcdr" step="0.1" value="52.0" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Left Center-Flange (wL)</label>
              <input type="number" id="input-wl" step="0.1" value="36.8" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Right Center-Flange (wR)</label>
              <input type="number" id="input-wr" step="0.1" value="21.8" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Spoke Hole Dia (mm)</label>
              <input type="number" id="input-sh" step="0.1" value="2.6" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Hub Center Offset (ho)</label>
              <input type="number" id="input-ho" step="0.1" value="0.0" class="bg-titanium-950 border border-titanium-800 rounded-lg px-3 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
            </div>
          </div>
        </div>

        <!-- 3. BUILD PARAMETERS -->
        <div class="flex flex-col gap-4">
          <h3 class="text-xs font-bold text-cyan-400 tracking-widest uppercase">Wheel Assembly</h3>
          <div class="flex flex-col gap-3">
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center text-xs text-titanium-400">
                <label class="font-medium">Total Spoke Count (N)</label>
                <span id="label-count" class="font-bold text-titanium-100 bg-titanium-950 px-2 py-0.5 rounded border border-titanium-800 mono-data">32</span>
              </div>
              <input type="range" id="input-count" min="16" max="40" step="4" value="32" class="w-full accent-cyan-500 h-1.5 bg-titanium-950 rounded-lg appearance-none cursor-pointer border border-titanium-800" />
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-titanium-400">Left Crosses</label>
                <select id="input-crossl" class="bg-titanium-950 border border-titanium-800 rounded-lg px-2 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none cursor-pointer">
                  <option value="0">Radial (0x)</option>
                  <option value="1">1 Cross (1x)</option>
                  <option value="2">2 Crosses (2x)</option>
                  <option value="3" selected="selected">3 Crosses (3x)</option>
                  <option value="4">4 Crosses (4x)</option>
                </select>
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-titanium-400">Right Crosses</label>
                <select id="input-crossr" class="bg-titanium-950 border border-titanium-800 rounded-lg px-2 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none cursor-pointer">
                  <option value="0">Radial (0x)</option>
                  <option value="1">1 Cross (1x)</option>
                  <option value="2">2 Crosses (2x)</option>
                  <option value="3" selected="selected">3 Crosses (3x)</option>
                  <option value="4">4 Crosses (4x)</option>
                </select>
              </div>
            </div>

            <div class="flex flex-col gap-1">
              <label class="text-xs font-medium text-titanium-400">Asymmetric Rim Orientation (Rim Flip)</label>
              <select id="input-rimflip" class="bg-titanium-950 border border-titanium-800 rounded-lg px-2 py-1.5 text-sm text-titanium-100 focus:border-cyan-500 focus:outline-none cursor-pointer">
                <option value="Auto" selected="selected">Auto-Balance Tension</option>
                <option value="Left">Orient Left (Standard)</option>
                <option value="Right">Orient Right (Flipped)</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Share Configuration Card -->
    <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-4 shadow-xl animate-fade-in flex items-center justify-between gap-3">
      <div class="flex flex-col gap-0.5">
        <span class="text-xs font-bold text-titanium-50 uppercase tracking-wide">Share Build</span>
        <span class="text-[10px] text-titanium-500">Copy URL to save or send specs</span>
      </div>
      <button id="copy-url-btn" class="flex items-center gap-1.5 px-3 py-1.5 bg-cyan-950/20 hover:bg-cyan-900/30 border border-cyan-500/20 hover:border-cyan-500/50 text-cyan-400 hover:text-cyan-300 text-xs font-bold rounded-xl transition-all">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
        </svg>
        Copy Link
      </button>
    </div>
  </div>

  <!-- RIGHT COLUMN: VIEWPORT & OUTCOMES -->
  <div class="flex-grow flex flex-col gap-6 animate-fade-in" style="animation-delay: 0.15s;">
    <!-- 3D Viewport Box -->
    <div class="relative bg-titanium-900/40 border border-titanium-850 rounded-2xl h-[420px] sm:h-[480px] lg:h-[520px] overflow-hidden shadow-2xl flex flex-col">
      <!-- 3D Canvas Container -->
      <div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing"></div>

      <!-- Hover Tooltip -->
      <div id="spoke-tooltip" class="absolute hidden bg-titanium-950/90 backdrop-blur-md border border-cyan-500/30 p-3 rounded-xl shadow-2xl text-xs flex flex-col gap-1 pointer-events-none z-30 min-w-[150px]">
        <div id="tooltip-title" class="font-bold text-cyan-400 flex items-center justify-between gap-2 border-b border-titanium-800 pb-1">
          <span>Spoke</span>
        </div>
        <div class="flex justify-between gap-4 mt-1">
          <span class="text-titanium-500">Calculated Length:</span>
          <span id="tooltip-length" class="font-bold text-titanium-100 mono-data">-- mm</span>
        </div>
        <div class="flex justify-between gap-4">
          <span class="text-titanium-500">Bracing Angle:</span>
          <span id="tooltip-bracing" class="font-semibold text-titanium-100 mono-data">--°</span>
        </div>
      </div>

      <!-- Camera Overlay controls -->
      <div class="absolute bottom-4 left-4 flex flex-wrap gap-2 z-20">
        <button data-cam="isometric" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Iso</button>
        <button data-cam="lateral" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Side (Lacing)</button>
        <button data-cam="dish" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Dish (Alignment)</button>
        <button data-cam="hub" class="cam-btn px-2.5 py-1.5 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 text-[11px] font-bold text-titanium-300 rounded-lg hover:text-titanium-100 hover:border-titanium-700 transition-all">Hub</button>
      </div>

      <!-- Settings Overlay controls -->
      <div class="absolute top-4 right-4 flex flex-col gap-2.5 z-20 items-end max-w-[200px]">
        <!-- Exploded Slider -->
        <div class="flex flex-col gap-1 px-3 py-2 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 rounded-xl w-full">
          <div class="flex justify-between text-[10px] font-bold text-titanium-400">
            <span>EXPLODE HUB</span>
            <span id="explode-val" class="mono-data">0%</span>
          </div>
          <input type="range" id="slider-explode" min="0" max="1" step="0.05" value="0" class="w-full h-1 bg-titanium-900 rounded appearance-none cursor-pointer accent-cyan-500" />
        </div>

        <!-- Visibility / Color Selects -->
        <div class="flex gap-1 bg-titanium-950/80 backdrop-blur-md border border-titanium-800 p-1 rounded-xl">
          <button id="toggle-l-spokes" class="px-2.5 py-1 text-[10px] font-bold rounded-lg bg-cyan-950/30 text-cyan-400 border border-cyan-500/20 hover:border-cyan-500/50 transition-all">NDS (L)</button>
          <button id="toggle-r-spokes" class="px-2.5 py-1 text-[10px] font-bold rounded-lg bg-cyan-950/30 text-cyan-400 border border-cyan-500/20 hover:border-cyan-500/50 transition-all">DS (R)</button>
          <select id="select-colormode" class="bg-titanium-950 border border-titanium-800 rounded-lg text-[10px] font-bold px-1 py-1 text-titanium-200 cursor-pointer focus:outline-none">
            <option value="classic">Titanium Steel</option>
            <option value="side">Side Colors</option>
            <option value="tension">Tension Guide</option>
          </select>
        </div>
      </div>

      <!-- Quick help text -->
      <div class="absolute bottom-4 right-4 pointer-events-none select-none text-[10px] text-titanium-500 font-semibold uppercase tracking-widest hidden md:block">
        Drag to Rotate • Scroll to Zoom • Hover Spoke to Measure
      </div>
    </div>

    <!-- CALCULATIONS GRID & ANALYTICS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Side-by-Side Outputs Table -->
      <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-5 shadow-xl">
        <h2 class="text-sm font-bold text-titanium-50 uppercase tracking-wider mb-4 border-b border-titanium-800 pb-2 flex justify-between">
          <span>Engine Output Metrics</span>
          <span class="text-xs font-semibold text-cyan-400 lowercase italic">Calculated</span>
        </h2>

        <div class="flex flex-col gap-4">
          <!-- Spoke Length Primary display -->
          <div class="grid grid-cols-2 gap-4">
            <!-- Left Side Length Card -->
            <div class="bg-titanium-950/50 border border-blue-500/10 p-3.5 rounded-xl flex flex-col gap-0.5">
              <span class="text-[10px] font-bold text-blue-400 uppercase tracking-wider">NDS (Left) Spoke Length</span>
              <span id="out-len-l" class="text-3xl font-bold text-titanium-50 tracking-tight mono-data">--<span class="text-lg text-titanium-500 ml-1">mm</span></span>
              <span id="out-len-l-round" class="text-xs text-titanium-400">Order: <span class="font-bold mono-data">-- mm</span></span>
            </div>

            <!-- Right Side Length Card -->
            <div class="bg-titanium-950/50 border border-red-500/10 p-3.5 rounded-xl flex flex-col gap-0.5">
              <span class="text-[10px] font-bold text-red-400 uppercase tracking-wider">DS (Right) Spoke Length</span>
              <span id="out-len-r" class="text-3xl font-bold text-titanium-50 tracking-tight mono-data">--<span class="text-lg text-titanium-500 ml-1">mm</span></span>
              <span id="out-len-r-round" class="text-xs text-titanium-400">Order: <span class="font-bold mono-data">-- mm</span></span>
            </div>
          </div>

          <!-- Extended physics analytics table -->
          <div class="flex flex-col gap-2.5 text-xs">
            <div class="flex items-center justify-between py-1.5 border-b border-titanium-800/40">
              <span class="text-titanium-400 font-medium">Effective Flange Offset</span>
              <div class="flex gap-6 font-bold mono-data">
                <span id="out-weff-l" class="text-blue-400">-- mm</span>
                <span id="out-weff-r" class="text-red-400">-- mm</span>
              </div>
            </div>

            <div class="flex items-center justify-between py-1.5 border-b border-titanium-800/40">
              <span class="text-titanium-400 font-medium">Lateral Bracing Angle</span>
              <div class="flex gap-6 font-semibold mono-data">
                <span id="out-bracing-l" class="text-blue-400">--°</span>
                <span id="out-bracing-r" class="text-red-400">--°</span>
              </div>
            </div>

            <div class="flex items-center justify-between py-1.5 border-b border-titanium-800/40">
              <span class="text-titanium-400 font-medium">Rim Wrap Angle (2D)</span>
              <div class="flex gap-6 font-semibold mono-data">
                <span id="out-wrap-l">--°</span>
                <span id="out-wrap-r">--°</span>
              </div>
            </div>

            <div class="flex items-center justify-between py-1.5 border-b border-titanium-800/40">
              <span class="text-titanium-400 font-medium">Total Rim Angle (3D)</span>
              <div class="flex gap-6 font-semibold mono-data">
                <span id="out-tot-l">--°</span>
                <span id="out-tot-r">--°</span>
              </div>
            </div>

            <div class="flex items-center justify-between py-1.5 border-b border-titanium-800/40">
              <span class="text-titanium-400 font-medium">Flange Exit Angle</span>
              <div class="flex gap-6 font-semibold mono-data">
                <span id="out-exit-l">--°</span>
                <span id="out-exit-r">--°</span>
              </div>
            </div>

            <div class="flex items-center justify-between py-1.5 border-b border-titanium-800/40">
              <span class="text-titanium-400 font-medium">Rotational Offset (Theta)</span>
              <div class="flex gap-6 font-semibold mono-data">
                <span id="out-theta-l">--°</span>
                <span id="out-theta-r">--°</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts & Tension Balance Panel -->
      <div class="bg-titanium-900/60 backdrop-blur-md border border-titanium-800/80 rounded-2xl p-5 shadow-xl flex flex-col gap-4">
        <h2 class="text-sm font-bold text-titanium-50 uppercase tracking-wider border-b border-titanium-800 pb-2">
          Physics Analysis & Balance
        </h2>

        <!-- Relative Tension Meter (Visual Component) -->
        <div class="flex flex-col gap-2 bg-titanium-950/40 border border-titanium-850 p-4 rounded-xl">
          <div class="flex justify-between items-end text-xs">
            <div class="flex flex-col gap-0.5">
              <span class="font-bold text-titanium-400 uppercase tracking-wider text-[10px]">Tension Balance</span>
              <span id="tension-ratio-label" class="text-lg font-bold text-cyan-400 mono-data">-- % : 100 %</span>
            </div>
            <span class="text-[10px] text-titanium-500 font-medium uppercase tracking-wide">Inversely proportional to W_eff</span>
          </div>

          <!-- Progress Bars -->
          <div class="flex flex-col gap-1.5 mt-2">
            <!-- Left Side Bar -->
            <div class="flex flex-col gap-0.5">
              <div class="flex justify-between text-[10px] font-bold text-titanium-400">
                <span>NDS (LEFT) TENSION</span>
                <span id="bar-pct-l" class="mono-data">--%</span>
              </div>
              <div class="w-full bg-titanium-950 rounded-full h-2 overflow-hidden border border-titanium-800">
                <div id="bar-fill-l" class="bg-gradient-to-r from-blue-600 to-blue-400 h-full transition-all duration-300" style="width: 0%;"></div>
              </div>
            </div>

            <!-- Right Side Bar -->
            <div class="flex flex-col gap-0.5">
              <div class="flex justify-between text-[10px] font-bold text-titanium-400">
                <span>DS (RIGHT) TENSION</span>
                <span id="bar-pct-r" class="mono-data">100%</span>
              </div>
              <div class="w-full bg-titanium-950 rounded-full h-2 overflow-hidden border border-titanium-800">
                <div id="bar-fill-r" class="bg-gradient-to-r from-red-600 to-red-400 h-full transition-all duration-300" style="width: 0%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bracing Angle Comparison Radial/Doughnut Chart -->
        <div class="flex-grow flex items-center justify-center min-h-[140px] relative">
          <canvas id="balanceChart" class="max-h-[160px]"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Dynamic imports and rendering executed strictly on client-side
  import { calculateWheelBuild } from '../utils/physicsCalculator';
  import { Viewport3D } from './Viewport3D';
  import { Chart } from 'chart.js/auto';

  let viewport: Viewport3D;
  let chartInstance: Chart | null = null;

  // DOM Elements - Presets
  const rimPreset = document.getElementById('rim-preset') as HTMLSelectElement;
  const hubPreset = document.getElementById('hub-preset') as HTMLSelectElement;

  // DOM Elements - Inputs
  const erdIn = document.getElementById('input-erd') as HTMLInputElement;
  const osbIn = document.getElementById('input-osb') as HTMLInputElement;
  const olIn = document.getElementById('input-ol') as HTMLInputElement;
  const orIn = document.getElementById('input-or') as HTMLInputElement;

  const pcdlIn = document.getElementById('input-pcdl') as HTMLInputElement;
  const pcdrIn = document.getElementById('input-pcdr') as HTMLInputElement;
  const wlIn = document.getElementById('input-wl') as HTMLInputElement;
  const wrIn = document.getElementById('input-wr') as HTMLInputElement;
  const shIn = document.getElementById('input-sh') as HTMLInputElement;
  const hoIn = document.getElementById('input-ho') as HTMLInputElement;

  const countIn = document.getElementById('input-count') as HTMLInputElement;
  const countLabel = document.getElementById('label-count') as HTMLElement;
  const crosslIn = document.getElementById('input-crossl') as HTMLSelectElement;
  const crossrIn = document.getElementById('input-crossr') as HTMLSelectElement;
  const rimflipIn = document.getElementById('input-rimflip') as HTMLSelectElement;

  // DOM Elements - Overlay / Viewport Settings
  const sliderExplode = document.getElementById('slider-explode') as HTMLInputElement;
  const explodeValLabel = document.getElementById('explode-val') as HTMLElement;
  const toggleLSpokes = document.getElementById('toggle-l-spokes') as HTMLButtonElement;
  const toggleRSpokes = document.getElementById('toggle-r-spokes') as HTMLButtonElement;
  const selectColorMode = document.getElementById('select-colormode') as HTMLSelectElement;

  // DOM Elements - Outputs
  const outLenL = document.getElementById('out-len-l') as HTMLElement;
  const outLenLRound = document.getElementById('out-len-l-round') as HTMLElement;
  const outLenR = document.getElementById('out-len-r') as HTMLElement;
  const outLenRRound = document.getElementById('out-len-r-round') as HTMLElement;

  const outWeffL = document.getElementById('out-weff-l') as HTMLElement;
  const outWeffR = document.getElementById('out-weff-r') as HTMLElement;
  const outBracingL = document.getElementById('out-bracing-l') as HTMLElement;
  const outBracingR = document.getElementById('out-bracing-r') as HTMLElement;
  const outWrapL = document.getElementById('out-wrap-l') as HTMLElement;
  const outWrapR = document.getElementById('out-wrap-r') as HTMLElement;
  const outTotL = document.getElementById('out-tot-l') as HTMLElement;
  const outTotR = document.getElementById('out-tot-r') as HTMLElement;
  const outExitL = document.getElementById('out-exit-l') as HTMLElement;
  const outExitR = document.getElementById('out-exit-r') as HTMLElement;
  const outThetaL = document.getElementById('out-theta-l') as HTMLElement;
  const outThetaR = document.getElementById('out-theta-r') as HTMLElement;

  // DOM Elements - Balance Meters
  const tensionRatioLabel = document.getElementById('tension-ratio-label') as HTMLElement;
  const barPctL = document.getElementById('bar-pct-l') as HTMLElement;
  const barPctR = document.getElementById('bar-pct-r') as HTMLElement;
  const barFillL = document.getElementById('bar-fill-l') as HTMLElement;
  const barFillR = document.getElementById('bar-fill-r') as HTMLElement;

  // DOM Elements - Share button
  const copyUrlBtn = document.getElementById('copy-url-btn') as HTMLButtonElement;

  // DOM Elements - 3D Tooltip
  const tooltip = document.getElementById('spoke-tooltip') as HTMLElement;
  const tooltipTitle = document.getElementById('tooltip-title') as HTMLElement;
  const tooltipLength = document.getElementById('tooltip-length') as HTMLElement;
  const tooltipBracing = document.getElementById('tooltip-bracing') as HTMLElement;

  // 1. GATHER ALL INPUT VALUES
  function getInputs() {
    return {
      erd: parseFloat(erdIn.value) || 601.0,
      osb: parseFloat(osbIn.value) || 0.0,
      drillingOffsetLeft: parseFloat(olIn.value) || 0.0,
      drillingOffsetRight: parseFloat(orIn.value) || 0.0,
      spokeCount: parseInt(countIn.value) || 32,
      spokeHoleDiameter: parseFloat(shIn.value) || 2.6,
      hubOffset: parseFloat(hoIn.value) || 0.0,
      rimFlip: rimflipIn.value as 'Auto' | 'Left' | 'Right',
      flangePcdLeft: parseFloat(pcdlIn.value) || 58.0,
      centerToLeft: parseFloat(wlIn.value) || 36.8,
      crossesLeft: parseInt(crosslIn.value) || 3,
      flangePcdRight: parseFloat(pcdrIn.value) || 52.0,
      centerToRight: parseFloat(wrIn.value) || 21.8,
      crossesRight: parseInt(crossrIn.value) || 3,
    };
  }

  // 2. RUN CALCULATIONS & RE-RENDER
  function updateAll() {
    const inputs = getInputs();

    // Set label spoke count
    countLabel.textContent = inputs.spokeCount.toString();

    // Trigger math engine
    const results = calculateWheelBuild(inputs);

    // Update Numerical DOM Output
    outLenL.innerHTML = `${results.left.calculatedSpokeLength.toFixed(1)}<span class="text-lg text-titanium-500 ml-1">mm</span>`;
    outLenLRound.innerHTML = `Order: <span class="font-bold text-titanium-100 mono-data">${Math.round(results.left.calculatedSpokeLength)} mm</span>`;
    outLenR.innerHTML = `${results.right.calculatedSpokeLength.toFixed(1)}<span class="text-lg text-titanium-500 ml-1">mm</span>`;
    outLenRRound.innerHTML = `Order: <span class="font-bold text-titanium-100 mono-data">${Math.round(results.right.calculatedSpokeLength)} mm</span>`;

    outWeffL.textContent = `${results.left.effectiveFlangeDistance.toFixed(1)} mm`;
    outWeffR.textContent = `${results.right.effectiveFlangeDistance.toFixed(1)} mm`;

    outBracingL.textContent = `${results.left.bracingAngle.toFixed(1)}°`;
    outBracingR.textContent = `${results.right.bracingAngle.toFixed(1)}°`;

    outWrapL.textContent = `${results.left.wrapAngleAtRim.toFixed(1)}°`;
    outWrapR.textContent = `${results.right.wrapAngleAtRim.toFixed(1)}°`;

    outTotL.textContent = `${results.left.totalAngleAtRim.toFixed(1)}°`;
    outTotR.textContent = `${results.right.totalAngleAtRim.toFixed(1)}°`;

    outExitL.textContent = `${results.left.flangeExitAngle.toFixed(1)}°`;
    outExitR.textContent = `${results.right.flangeExitAngle.toFixed(1)}°`;

    outThetaL.textContent = `${results.left.thetaAngle.toFixed(1)}°`;
    outThetaR.textContent = `${results.right.thetaAngle.toFixed(1)}°`;

    // Tension Balance Meters
    const tL = results.tensionRatioLeft;
    const tR = results.tensionRatioRight;
    tensionRatioLabel.textContent = `${tL.toFixed(0)} % : ${tR.toFixed(0)} %`;
    
    barPctL.textContent = `${tL.toFixed(0)}%`;
    barPctR.textContent = `${tR.toFixed(0)}%`;

    barFillL.style.width = `${tL}%`;
    barFillR.style.width = `${tR}%`;

    // Trigger Three.js Re-build
    if (viewport) {
      viewport.update(inputs);
    }

    // Trigger Charts Re-build
    updateCharts(results.left.bracingAngle, results.right.bracingAngle);

    // Update URL Hash for saving/sharing
    updateHash(inputs);
  }

  // 3. CHARTS UPDATES (Using Chart.js)
  function updateCharts(bracingL: number, bracingR: number) {
    const ctx = (document.getElementById('balanceChart') as HTMLCanvasElement)?.getContext('2d');
    if (!ctx) return;

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [bracingL, bracingR];
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['NDS Bracing', 'DS Bracing'],
          datasets: [{
            label: 'Bracing Angle (deg)',
            data: [bracingL, bracingR],
            backgroundColor: ['rgba(59, 130, 246, 0.45)', 'rgba(239, 68, 68, 0.45)'],
            borderColor: ['#3b82f6', '#ef4444'],
            borderWidth: 1.5,
            borderRadius: 6,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { enabled: true }
          },
          scales: {
            y: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#919299', font: { family: 'JetBrains Mono' } },
              max: 15,
              min: 0
            },
            x: {
              grid: { display: false },
              ticks: { color: '#bebfc4', font: { family: 'Space Grotesk', weight: 'bold' } }
            }
          }
        }
      });
    }
  }

  // 4. PRESETS EVENT LISTENERS
  rimPreset.addEventListener('change', () => {
    const selectedOpt = rimPreset.options[rimPreset.selectedIndex];
    if (rimPreset.value !== 'custom') {
      erdIn.value = selectedOpt.getAttribute('data-erd') || '';
      osbIn.value = selectedOpt.getAttribute('data-osb') || '0';
      olIn.value = selectedOpt.getAttribute('data-ol') || '0';
      orIn.value = selectedOpt.getAttribute('data-or') || '0';
      updateAll();
    }
  });

  hubPreset.addEventListener('change', () => {
    const selectedOpt = hubPreset.options[hubPreset.selectedIndex];
    if (hubPreset.value !== 'custom') {
      pcdlIn.value = selectedOpt.getAttribute('data-pcdl') || '';
      pcdrIn.value = selectedOpt.getAttribute('data-pcdr') || '';
      wlIn.value = selectedOpt.getAttribute('data-wl') || '';
      wrIn.value = selectedOpt.getAttribute('data-wr') || '';
      shIn.value = selectedOpt.getAttribute('data-sh') || '';
      updateAll();
    }
  });

  // Automatically decouple presets if values are manually edited
  const manualInputs = [erdIn, osbIn, olIn, orIn, pcdlIn, pcdrIn, wlIn, wrIn, shIn, hoIn];
  manualInputs.forEach(elem => {
    elem.addEventListener('input', () => {
      if (elem === erdIn || elem === osbIn || elem === olIn || elem === orIn) {
        rimPreset.value = 'custom';
      } else {
        hubPreset.value = 'custom';
      }
      updateAll();
    });
  });

  // Other form event listeners
  countIn.addEventListener('input', updateAll);
  crosslIn.addEventListener('change', updateAll);
  crossrIn.addEventListener('change', updateAll);
  rimflipIn.addEventListener('change', updateAll);

  // 5. VIEWPORT DISPLAY CONTROLS
  sliderExplode.addEventListener('input', () => {
    const val = parseFloat(sliderExplode.value);
    explodeValLabel.textContent = `${Math.round(val * 100)}%`;
    if (viewport) {
      viewport.explodedValue = val;
      viewport.update(getInputs());
    }
  });

  let showLeft = true;
  toggleLSpokes.addEventListener('click', () => {
    showLeft = !showLeft;
    toggleLSpokes.classList.toggle('bg-cyan-950/30', showLeft);
    toggleLSpokes.classList.toggle('text-cyan-400', showLeft);
    toggleLSpokes.classList.toggle('bg-titanium-950', !showLeft);
    toggleLSpokes.classList.toggle('text-titanium-500', !showLeft);
    if (viewport) {
      viewport.showLeftSpokes = showLeft;
      viewport.update(getInputs());
    }
  });

  let showRight = true;
  toggleRSpokes.addEventListener('click', () => {
    showRight = !showRight;
    toggleRSpokes.classList.toggle('bg-cyan-950/30', showRight);
    toggleRSpokes.classList.toggle('text-cyan-400', showRight);
    toggleRSpokes.classList.toggle('bg-titanium-950', !showRight);
    toggleRSpokes.classList.toggle('text-titanium-500', !showRight);
    if (viewport) {
      viewport.showRightSpokes = showRight;
      viewport.update(getInputs());
    }
  });

  selectColorMode.addEventListener('change', () => {
    if (viewport) {
      viewport.colorMode = selectColorMode.value as 'classic' | 'side' | 'tension';
      viewport.update(getInputs());
    }
  });

  // Camera preset selectors
  document.querySelectorAll('.cam-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-cam') as 'isometric' | 'lateral' | 'dish' | 'hub';
      if (viewport) viewport.setCameraPreset(p);
    });
  });

  // 6. RAYCAST INTERACTION EVENT HANDLERS
  window.addEventListener('spoke-hover', (e: any) => {
    const { side, index, isLeading, length, bracingAngle, event } = e.detail;
    
    // Position tooltip absolute near cursor
    tooltip.style.left = `${event.clientX - 10}px`;
    tooltip.style.top = `${event.clientY - 110}px`;
    tooltip.classList.remove('hidden');

    tooltipTitle.innerHTML = `<span>${side} Side Spoke #${index + 1}</span><span class="text-[9px] px-1.5 py-0.5 rounded ${isLeading ? 'bg-cyan-950/50 text-cyan-400 border border-cyan-500/10' : 'bg-violet-950/50 text-violet-400 border border-violet-500/10'} font-bold uppercase">${isLeading ? 'Leading' : 'Trailing'}</span>`;
    tooltipLength.textContent = `${length.toFixed(1)} mm`;
    tooltipBracing.textContent = `${bracingAngle.toFixed(1)}°`;
  });

  window.addEventListener('spoke-unhover', () => {
    tooltip.classList.add('hidden');
  });

  // 7. URL HASH SHARING
  function updateHash(inputs: ReturnType<typeof getInputs>) {
    const params = new URLSearchParams();
    for (const [key, val] of Object.entries(inputs)) {
      params.set(key, val.toString());
    }
    // Update preset names too
    params.set('rp', rimPreset.value);
    params.set('hp', hubPreset.value);

    // Silent hash update
    history.replaceState(null, '', `#${params.toString()}`);
  }

  function loadHash() {
    const hash = window.location.hash;
    if (!hash || hash.length < 2) return false;

    try {
      const params = new URLSearchParams(hash.substring(1));
      
      // Load presets first
      const rpVal = params.get('rp');
      const hpVal = params.get('hp');
      if (rpVal) rimPreset.value = rpVal;
      if (hpVal) hubPreset.value = hpVal;

      // Load specific geometry fields
      const mapField = (id: string, paramName: string) => {
        const input = document.getElementById(id) as HTMLInputElement;
        const val = params.get(paramName);
        if (input && val !== null) input.value = val;
      };

      mapField('input-erd', 'erd');
      mapField('input-osb', 'osb');
      mapField('input-ol', 'ol');
      mapField('input-or', 'or');
      mapField('input-pcdl', 'flangePcdLeft');
      mapField('input-pcdr', 'flangePcdRight');
      mapField('input-wl', 'centerToLeft');
      mapField('input-wr', 'centerToRight');
      mapField('input-sh', 'spokeHoleDiameter');
      mapField('input-ho', 'hubOffset');
      mapField('input-count', 'spokeCount');
      mapField('input-crossl', 'crossesLeft');
      mapField('input-crossr', 'crossesRight');
      mapField('input-rimflip', 'rimFlip');

      return true;
    } catch (e) {
      console.warn('Failed parsing share link parameters:', e);
      return false;
    }
  }

  copyUrlBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href);
    
    // Quick copy visual feedback
    const originalText = copyUrlBtn.innerHTML;
    copyUrlBtn.innerHTML = `
      <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
      Link Copied!
    `;
    copyUrlBtn.classList.remove('bg-cyan-950/20', 'border-cyan-500/20', 'text-cyan-400');
    copyUrlBtn.classList.add('bg-emerald-950/20', 'border-emerald-500/50', 'text-emerald-400');

    setTimeout(() => {
      copyUrlBtn.innerHTML = originalText;
      copyUrlBtn.classList.add('bg-cyan-950/20', 'border-cyan-500/20', 'text-cyan-400');
      copyUrlBtn.classList.remove('bg-emerald-950/20', 'border-emerald-500/50', 'text-emerald-400');
    }, 2000);
  });

  // 8. BOOTSTRAP INITIALIZATION
  window.addEventListener('DOMContentLoaded', () => {
    const canvasContainer = document.getElementById('canvas-container');
    if (!canvasContainer) return;

    // Load any shared configuration from URL hash
    loadHash();

    // Initialize 3D Viewport
    viewport = new Viewport3D(canvasContainer);
    viewport.setCameraPreset('isometric');

    // Initial update trigger
    updateAll();
  });
</script>
