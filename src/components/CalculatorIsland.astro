  let hoveredLacingTarget: LacingTarget | null = null;
  let focusedLacingTarget: LacingTarget | null = null;
  let pinnedLacingTarget: LacingTarget | null = null;
  function refreshLacingHighlight(locate = false) {
    const target = hoveredLacingTarget ?? focusedLacingTarget ?? pinnedLacingTarget;
    viewport?.emphasizeLacingTarget(target, locate);
    if (locate && target && !setupFigure.classList.contains('hidden') && diagramToggle.getAttribute('aria-expanded') === 'true') {
      const marker = document.querySelector<HTMLElement>('.lacing-target-marker');
      const point = marker?.getBoundingClientRect();
      const panel = setupFigure.getBoundingClientRect();
      if (point && point.x >= panel.left && point.x <= panel.right && point.y >= panel.top && point.y <= panel.bottom) {
        setDiagramExpanded(false);
      }
    }
    paneLacing.querySelectorAll<HTMLElement>('[data-lacing-target]').forEach(link => {
      link.dataset.highlighted = String(link.dataset.lacingTarget === target);
    });
  }
  function clearLacingHighlight() {
    hoveredLacingTarget = focusedLacingTarget = pinnedLacingTarget = null;
    refreshLacingHighlight();
  }
  function holeLink(text: string, target: LacingTarget): HTMLButtonElement {
    // This is an in-page action styled as a hyperlink, so use button semantics.
    // In particular, do not replace the build parameters in the URL fragment.
    const link = document.createElement('button');
    link.type = 'button'; link.className = 'guide-target-link'; link.textContent = text;
    link.dataset.lacingTarget = target;
    link.setAttribute('aria-controls', 'canvas-container');
    link.setAttribute('aria-describedby', 'lacing-link-help');
    link.addEventListener('pointerenter', event => {
      if (event.pointerType === 'touch') return;
      hoveredLacingTarget = target; refreshLacingHighlight();
    });
    link.addEventListener('pointerleave', () => { hoveredLacingTarget = null; refreshLacingHighlight(); });
    link.addEventListener('focus', () => { focusedLacingTarget = target; refreshLacingHighlight(); });
    link.addEventListener('blur', () => { focusedLacingTarget = null; refreshLacingHighlight(); });
    link.addEventListener('click', () => {
      pinnedLacingTarget = target; hoveredLacingTarget = null; focusedLacingTarget = target;
      refreshLacingHighlight(true);
      const canvas = document.getElementById('canvas-container')!;
      const bounds = canvas.getBoundingClientRect();
      if (bounds.top < 0 || bounds.bottom > window.innerHeight - 88) {
        canvas.scrollIntoView({ block: 'center', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      }
    });
    return link;
  }
  window.addEventListener('keydown', event => { if (event.key === 'Escape') clearLacingHighlight(); });

  let lastAnnouncement = '';
  const resetInstructionView = document.getElementById('btn-reset-instruction-view') as HTMLButtonElement;
  resetInstructionView.addEventListener('click', () => {
    clearLacingHighlight();
    viewport?.resetLacingView();
  });
  const setupFigure = document.getElementById('lacing-setup-figure')!;
  document.getElementById('canvas-container')!.append(setupFigure);
  const diagramToggle = document.getElementById('lacing-diagram-toggle')!;
  let lastDiagramKey = '';
  function setDiagramExpanded(expanded: boolean) {
    diagramToggle.setAttribute('aria-expanded', String(expanded));
    document.getElementById('lacing-diagram-content')!.classList.toggle('hidden', !expanded);
    document.getElementById('lacing-diagram-toggle-icon')!.textContent = expanded ? '−' : '+';
  }
  diagramToggle.addEventListener('click', () => setDiagramExpanded(diagramToggle.getAttribute('aria-expanded') !== 'true'));
  function renderLacing(detail: LacingSnapshot) {
    clearLacingHighlight();
    const { step, valid, preview, totalSpokes, totalPairs, targetPair, activeSpoke, targetSpoke, notice } = detail;
    resetInstructionView.disabled = !valid;
    const patternStatus = document.getElementById('lacing-pattern-status')!;
    patternStatus.textContent = detail.interlaced ? 'This build uses optional interlaced routing: change sides at the outermost crossing. Radial sides have no weave.' : 'Non-interlaced on both sides (default): retain the same layer at every crossing. Flange holes still alternate heads-out and heads-in.';
    document.getElementById('btn-lacing-use-noninterlacing')!.classList.toggle('hidden', !detail.interlaced);
    (document.getElementById('btn-lacing-use-noninterlacing') as HTMLButtonElement).disabled = !valid;
    lacingSpokeCounter.textContent = !valid ? 'Guide unavailable' : preview ? `Preview · saved pair ${step} / ${totalPairs}` : step === 0 ? `Setup · ${totalPairs} pairs · ${totalSpokes} spokes` : `Pair ${step} / ${totalPairs} · ${detail.representedSpokes} / ${totalSpokes} spokes`;
    document.getElementById('lacing-notice')!.textContent = notice;
    document.getElementById('lacing-error')!.classList.toggle('hidden', valid);
    document.getElementById('lacing-error-text')!.textContent = detail.errors.slice(0, 2).join(' ');
    document.getElementById('lacing-progress')!.classList.toggle('hidden', !valid);
    barOverallLacing.value = detail.percent ?? 0;
    lacingPercentLabel.textContent = valid ? `${detail.percent}%` : '';
    btnPrevSpoke.disabled = !detail.canPrevious;
    btnNextSpoke.disabled = !detail.canNext;
    btnNextSpoke.textContent = step === 0 ? 'Start pair 1' : step === totalPairs ? 'Lacing complete' : 'Next pair';
    btnPrevGroup.disabled = !detail.canPrevious;
    btnNextGroup.disabled = !detail.canNextGroup;
    btnLacingComplete.disabled = !valid || preview;
    document.getElementById('lacing-step-controls')!.classList.toggle('hidden', preview);
    btnLacingReturn.classList.toggle('hidden', !preview);
    btnCamFixed.setAttribute('aria-pressed', String(!detail.cameraTracking));
    btnCamAutotrack.setAttribute('aria-pressed', String(detail.cameraTracking));
    [badgeG1Count, badgeG2Count, badgeG3Count, badgeG4Count].forEach((count, i) => {
      count.textContent = valid ? `${detail.groupCounts[i]} / ${detail.groupTotals[i]}` : 'Unavailable';
      document.getElementById(`badge-g${i + 1}-name`)!.textContent = `${i + 1}. ${detail.groupNames[i]}`;
      const badge = document.getElementById(`badge-group-${i + 1}`)!;
      badge.setAttribute('aria-current', String(detail.currentGroups.includes(i + 1)));
      badge.style.borderColor = detail.currentGroups.includes(i + 1) ? '#22d3ee' : '';
    });
    lacingSpokeTitle.textContent = !valid ? 'Geometry needs attention' : preview ? 'All spokes preview' : activeSpoke ? `Pair ${step}: ${activeSpoke.side} flange` : 'Setup: locate the first pair';
    lacingSpokeSideBadge.textContent = preview ? 'Sequence position preserved' : targetSpoke ? `View from ${targetSpoke.viewingLabel} side` : '';
    document.getElementById('lacing-direction-help')!.textContent = !preview && targetSpoke ?
      `Directions use this flange’s outside view. Reset instruction view restores it with the valve at the top. “Skip one hole” means pass one hole and use the following hole.` : '';
    const setup = detail.setup;
    const showSpoke = valid && !preview && targetSpoke;
    document.getElementById('lacing-target-summary')!.classList.toggle('hidden', !showSpoke);
    setupFigure.classList.toggle('hidden', !showSpoke);
    document.getElementById('lacing-setup-orientation')!.classList.toggle('hidden', !showSpoke);
    const adjustment = document.getElementById('lacing-setup-adjustment') as HTMLDetailsElement;
    adjustment.classList.toggle('hidden', !setup);
    if (showSpoke) {
      document.getElementById('lacing-diagram-title')!.textContent = `${targetSpoke!.side} flange · pair ${targetPair!.index+1}`;
      document.getElementById('lacing-diagram-view')!.textContent = `Intended positions · viewed from ${targetSpoke!.viewingLabel} side`;
      document.getElementById('lacing-diagram-caption')!.textContent = `Intended positions · valve at top. Cyan: A, heads-out. Green: B, heads-in. Amber: installed crossing references. ${targetSpoke!.crosses===0 ? 'Radial: no crossings.' : 'Numbered crossings run from hub to rim; the bridge marks the outside layer.'} ${setup ? 'Enlarged flange inset: amber arrows count holes.' : ''}`;
      const diagramKey = `${detail.key}:${targetSpoke!.sequenceIndex}`;
      if (diagramKey !== lastDiagramKey) setDiagramExpanded(true);
      lastDiagramKey = diagramKey;
    }
    document.getElementById('lacing-setup-diagram')!.innerHTML = showSpoke ?
      lacingSpokeDiagram(targetSpoke!, detail.valveAngle, detail.installedSpokes, targetPair!.b) + (setup ? lacingSetupDiagram(setup) : '') : '';
    const intro = document.getElementById('lacing-setup-intro')!;
    intro.replaceChildren();
    if (setup?.referenceAcrossHub) {
      intro.append(`Turn the supported wheel to view the ${setup.viewingLabel} side. Anchor the left side to `,
        holeLink(`installed spoke ${setup.referenceStep} on the right flange`, 'reference-flange'),
        `. Compare the flanges along the axle and use the first staggered hole ${setup.direction}. Use that same installed spoke at the rim, following the counts below. Keep the existing right-side connections; do not restart from the valve or logo.`);
    } else if (setup) {
      intro.append('The diagrams show the intended assembled position. Use the enlarged flange inset to count from ',
        holeLink(setup.referenceStep ? `the hole of spoke ${setup.referenceStep}, already installed` : 'the amber hole beside the valve line', setup.referenceTarget),
        '. Keep the existing hub-to-rim alignment; logo alignment is cosmetic.');
    } else if (showSpoke) intro.textContent = 'Position A and B together before attaching either nipple. Follow both routes and every identified crossing.';
    document.getElementById('lacing-setup-adjustment-text')!.textContent =
      'Support the rim with axle clearance. Insert A from outside and hold its shaft while tilting the supported wheel to reach the inside face for B. Keep both nipples unattached until both routes are positioned. These diagrams do not simulate insertion movements. Stop and reposition if obstructed.';
    lacingFlangeHoleText.replaceChildren(...(showSpoke ? [holeLink(`Flange hole ${targetPair!.a.flangeHoleIndex}`, 'flange'), ' → ',holeLink(`rim hole ${targetPair!.a.rimHoleIndex}`,'rim')] : ['—']));
    lacingHeadsDirText.textContent = showSpoke ? 'A: head outside · insert from outside' : '';
    lacingRimHoleText.replaceChildren(...(showSpoke ? [holeLink(`Flange hole ${targetPair!.b.flangeHoleIndex}`, 'b-flange'),' → ',holeLink(`rim hole ${targetPair!.b.rimHoleIndex}`,'b-rim'), ' · B: head inside · insert from inside'] : ['—']));
    const selection = detail.spokeSelection;
    const orientation = showSpoke ? [targetPair!.a,targetPair!.b].map((spoke,i)=>`${i?'B':'A'}: ${spoke.orientationText}`).join(' ') : '';
    const orientationText = document.getElementById('lacing-spoke-orientation')!;
    orientationText.textContent = orientation;
    orientationText.classList.toggle('hidden', !orientation);
    document.getElementById('lacing-orientation-checkpoint')!.classList.toggle('hidden', !detail.orientationCheckpoint);
    document.getElementById('lacing-checkpoint-title')!.textContent = detail.checkpointTitle;
    document.getElementById('lacing-checkpoint-text')!.textContent = detail.orientationCheckpoint ?? '';
    lacingSpokeLengthText.classList.toggle('hidden', !selection);
    lacingSpokeLengthText.textContent = selection ? `${selection.label} — Purchased: ${getPurchasedLength(targetSpoke?.side ?? 'Left', selection.roundedLength)} mm each (A and B) · calculated rounding: ${selection.roundedLength} mm` : '';
    lacingRuleTipText.replaceChildren();
    document.getElementById('lacing-link-help')!.classList.toggle('hidden', !valid || preview);
    if (!valid || preview || !targetSpoke) {
      const item = document.createElement('li');
      item.textContent = preview ? 'This shows the entire spoke pattern. Return to Step to continue from your saved position.' : 'Correct the build dimensions to generate a complete lacing sequence.';
      lacingRuleTipText.append(item);
    } else if (step === 0) {
      const item = document.createElement('li');
      item.textContent = 'Support the rim with axle clearance. Work with one loose pair at a time: A heads-out, B heads-in. Position both routes before attaching either nipple loosely. Finish every right-flange pair, check routing, then move to the left. Do not put all heads on the same face. Select Start pair 1 to begin.';
      lacingRuleTipText.append(item);
    } else {
      for (const parts of targetSpoke.instructionSteps) {
        const item = document.createElement('li');
        for (const part of parts) item.append(part.target ? holeLink(part.text, part.target) : document.createTextNode(part.text));
        lacingRuleTipText.append(item);
      }
    }
    const announcement = `${patternStatus.textContent} ${lacingSpokeCounter.textContent}. ${lacingSpokeTitle.textContent}. ${!preview && targetSpoke ? `${targetSpoke.sideLabel}. ${targetSpoke.headsDir}. ${selection ? `Purchased spoke length ${getPurchasedLength(targetSpoke.side, selection.roundedLength)} millimetres; calculated rounding ${selection.roundedLength} millimetres. ` : ''}${orientation} ${step > 0 ? targetSpoke.instructionSteps.flat().map(p => p.text).join(" ") ?? "" : "One heads-out and one heads-in spoke per pair. Position both before attaching either nipple; select Start pair 1."}` : ''} ${detail.orientationCheckpoint ?? ''} ${notice}`;
    if (announcement !== lastAnnouncement) {
      document.getElementById('lacing-announcement')!.textContent = announcement;
      lastAnnouncement = announcement;
    }
  }
  window.addEventListener('lacing-update', event => renderLacing(event.detail));
  window.addEventListener('lacing-view-change', event => {
    document.getElementById('lacing-viewing-side')!.textContent = event.detail;
  });

  function getPurchasedLength(side: string, rounded: number) {
    const settings = readNippleFitSettings();
    return (side === 'Left' ? settings.purchasedLengthLeft : settings.purchasedLengthRight) ?? rounded;
  }

  // 8. BUILD PERSISTENCE AND EXPLICIT SHARING
  const sessionStorageForBuild = () => window.sessionStorage;
  let importedFragment: string | null = null;

  function captureConfiguration(): BuildConfiguration {
    const inputs = getInputs();
    const measurements = Object.fromEntries(Object.entries(numericFields).map(([key, id]) => {
      const value = numeric(document.getElementById(id) as HTMLInputElement);
      return [key, Number.isFinite(value) ? value : null];
    })) as Record<NumericField, number | null>;
    return {
      ...measurements, ...readNippleFitSettings(), rp: rimPreset.value, hp: hubPreset.value,
      rimProfile: rimAppearance.rimProfile ?? 'standard',
      rimEyelets: rimAppearance.rimEyelets ?? false,
      rimValveDiameter: rimAppearance.rimValveDiameter ?? 6.5,
      rimFlip: inputs.rimFlip, interlaced,
      isRear: inputs.isRear, spacing: inputs.spacing, discType: inputs.discType,
    };
  }

  function applyConfiguration(config: BuildConfiguration) {
    rimPreset.value = config.rp;
    hubPreset.value = config.hp;
    applyRimPreset();
    applyHubPreset();
    for (const [key, id] of Object.entries({...numericFields, ...fitNumericFields})) {
      const value = config[key as NumericField | keyof typeof fitNumericFields];
      (document.getElementById(id) as HTMLInputElement).value = value === null ? '' : String(value);
    }
    rimAppearance = { rimProfile: config.rimProfile, rimEyelets: config.rimEyelets, rimValveDiameter: config.rimValveDiameter };
    rimflipIn.value = config.rimFlip;
    interlaced = config.interlaced;
    if (viewport) viewport.enableInterlacing = interlaced;
    customHubType = config.isRear ? 'Rear' : 'Front';
    customHubSpacing = config.spacing;
    customHubDisc = config.discType;
    if (config.hp === 'custom') geometryProvenance = 'User-entered geometry; approximate measurements.';
    syncHubControls();
    syncInterlaceControl();
  }

  const workshopLink = document.getElementById('workshop-link') as HTMLAnchorElement | null;

  function saveCurrentBuild() {
    if (workshopLink) workshopLink.href = '/workshop#' + serializeConfiguration(captureConfiguration(), false);
    const saved = saveConfiguration(captureConfiguration(), sessionStorageForBuild);
    if (saved && importedFragment !== null && window.location.hash === importedFragment) {
      history.replaceState(history.state, '', window.location.pathname + window.location.search);
      importedFragment = null;
    }
    return saved;
  }

  const shareStatus = document.getElementById('share-status')!;
  const shareFallback = document.getElementById('share-link-fallback')!;
  const shareValue = document.getElementById('share-link-value') as HTMLInputElement;
  shareValue.addEventListener('click', () => shareValue.select());
  copyUrlBtn.addEventListener('click', async () => {
    const url = new URL(window.location.href);
    url.hash = serializeConfiguration(captureConfiguration());
    copyUrlBtn.disabled = true;
    shareStatus.textContent = '';
    shareFallback.classList.add('hidden');
    try {
      await navigator.clipboard.writeText(url.href);
      shareStatus.textContent = 'Build link copied.';
    } catch {
      shareStatus.textContent = 'Automatic copying is unavailable. Select and copy the link below.';
      shareValue.value = url.href;
      shareFallback.classList.remove('hidden');
      shareValue.focus();
      shareValue.select();
    } finally {
      copyUrlBtn.disabled = false;
    }
  });

  // 9. INITIALIZATION
  let initialized = false;
  function restoreBuild() {
    const restored = restoreConfiguration(window.location.hash, sessionStorageForBuild);
    applyConfiguration(restored.config);
    importedFragment = restored.imported ? window.location.hash : null;
    const message = document.getElementById('build-import-error')!;
    message.classList.toggle('hidden', !restored.error);
    if (restored.error) {
      message.textContent = `Could not open the shared build: ${restored.error} Your saved build or defaults have been loaded.`;
    }
  }
  window.addEventListener('hashchange', () => {
    if (!initialized || parseConfiguration(window.location.hash).kind === 'unrelated') return;
    restoreBuild();
    updateAll();
  });
  function initialize() {
    if (initialized) return;
    initialized = true;
    restoreBuild();
    setViewportState('idle');
    updateAll();
    loadWhenNearViewport(document.getElementById('viewport-card'), ensureViewport);
    loadWhenNearViewport(document.getElementById('balanceChart'), ensureChart);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }
</script>
