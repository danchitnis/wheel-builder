  async function ensureChart() {
    if (chartInstance) return;
    if (chartLoad) return chartLoad;

    chartLoad = import('./BracingChart')
      .then(({ createBracingChart }) => {
        const canvas = document.getElementById('balanceChart') as HTMLCanvasElement | null;
        if (!canvas || chartInstance) return;
        const results = calculateWheelBuild(getInputs());
        chartInstance = createBracingChart(
          canvas,
          latestChartValues ?? [results.left.bracingAngle, results.right.bracingAngle],
        );
      })
      .catch(error => {
        chartLoad = null;
        console.error('Failed to load the bracing chart:', error);
      });

    return chartLoad;
  }

  function loadWhenNearViewport(element: Element | null, load: () => Promise<void> | null) {
    if (!element) return;
    if (!('IntersectionObserver' in window)) {
      void load();
      return;
    }

    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      void load();
    }, { rootMargin: '200px' });
    observer.observe(element);
  }

  // Helpers to apply preset selection to form fields
  function applyRimPreset() {
    const selectedOpt = rimPreset.options[rimPreset.selectedIndex];
    if (rimPreset.value !== 'custom' && selectedOpt) {
      readRimAppearance();
      if (selectedOpt.hasAttribute('data-erd')) erdIn.value = selectedOpt.getAttribute('data-erd') || '392.0';
      if (selectedOpt.hasAttribute('data-osb')) osbIn.value = selectedOpt.getAttribute('data-osb') || '0.0';
      if (selectedOpt.hasAttribute('data-ol')) olIn.value = selectedOpt.getAttribute('data-ol') || '0.0';
      if (selectedOpt.hasAttribute('data-or')) orIn.value = selectedOpt.getAttribute('data-or') || '0.0';
      if (selectedOpt.hasAttribute('data-wo')) woIn.value = selectedOpt.getAttribute('data-wo') || '22.5';
      if (selectedOpt.hasAttribute('data-wi')) wiIn.value = selectedOpt.getAttribute('data-wi') || '17.5';
      if (selectedOpt.hasAttribute('data-dep')) depIn.value = selectedOpt.getAttribute('data-dep') || '15.5';
    }
  }

  function applyHubPreset() {
    const selectedOpt = hubPreset.options[hubPreset.selectedIndex];
    if (hubPreset.value !== 'custom' && selectedOpt) {
      customHubType = selectedOpt.dataset.hubtype ?? 'Rear';
      customHubSpacing = selectedOpt.dataset.spacing ?? '';
      customHubDisc = (selectedOpt.dataset.disctype as typeof customHubDisc) ?? '6-Bolt';
      if (selectedOpt.hasAttribute('data-pcdl')) pcdlIn.value = selectedOpt.getAttribute('data-pcdl') || '57.0';
      if (selectedOpt.hasAttribute('data-pcdr')) pcdrIn.value = selectedOpt.getAttribute('data-pcdr') || '59.0';
      if (selectedOpt.hasAttribute('data-wl')) wlIn.value = selectedOpt.getAttribute('data-wl') || String(defaultHub.centerToLeft);
      if (selectedOpt.hasAttribute('data-wr')) wrIn.value = selectedOpt.getAttribute('data-wr') || String(defaultHub.centerToRight);
      if (selectedOpt.hasAttribute('data-sh')) shIn.value = selectedOpt.getAttribute('data-sh') || '2.6';
      odlIn.value = selectedOpt.dataset.odl ?? '';
      odrIn.value = selectedOpt.dataset.odr ?? '';
      ftlIn.value = selectedOpt.dataset.ftl ?? '';
      ftrIn.value = selectedOpt.dataset.ftr ?? '';
      geometryProvenance = selectedOpt.dataset.provenance ?? 'Outside diameters not measured. Enter dimensions to enable the 3D path estimate; thickness from the catalogue is an assumption.';
    }
  }

  // 3. RUN CALCULATIONS & RE-RENDER ALL VISUALIZERS
  function updateAll() {
    syncHubControls();
    const inputs = getInputs();

    // Label spoke count
    if (countLabel) countLabel.textContent = inputs.spokeCount.toString();

    // Trigger math engine
    const results = calculateWheelBuild(inputs);
    const paths = calculateSpokePaths(inputs);
    nippleFitPanel.refresh(inputs, paths);
    const leftLabel = wheelSideLabel(inputs, 'Left');
    const rightLabel = wheelSideLabel(inputs, 'Right');
    for (const node of document.querySelectorAll<HTMLElement>('[data-wheel-side]')) {
      node.textContent = node.dataset.wheelSide === 'Left' ? leftLabel : rightLabel;
    }
    document.querySelector('[data-side-label="left-length"]')!.textContent = `${leftLabel} — traditional`;
    document.querySelector('[data-side-label="right-length"]')!.textContent = `${rightLabel} — traditional`;
    toggleLSpokes.textContent = leftLabel;
    toggleRSpokes.textContent = rightLabel;
    const rows = document.getElementById('path-results')!;
    rows.replaceChildren();
    for (const side of ['Left', 'Right'] as const) for (const headsOut of [true, false]) {
      const group = paths.spokes.filter(p => p.side === side && p.headsOut === headsOut);
      const row = document.createElement('tr');
      const name = `${side === 'Left' ? leftLabel : rightLabel}, heads-${headsOut ? 'out' : 'in'}`;
      const range = (key: 'pathLength' | 'bendAllowance' | 'estimatedLength') => {
        if (!group.length || group.some(p => !p.valid)) return 'Unavailable';
        const values = group.map(p => p[key]), low = Math.min(...values), high = Math.max(...values);
        return high - low < 0.05 ? low.toFixed(1) : `${low.toFixed(1)}–${high.toFixed(1)}`;
      };
      for (const value of [name, range('pathLength'), range('bendAllowance'), range('estimatedLength')]) {
        const cell = document.createElement('td'); cell.className = 'py-2 pr-3 border-t border-titanium-800'; cell.textContent = value; row.append(cell);
      }
      rows.append(row);
    }
    document.getElementById('path-errors')!.textContent = paths.errors.length ? paths.errors[0] : '';

    const sensitivities = document.getElementById('sensitivity-results')!;
    sensitivities.replaceChildren();
    for (const sensitivity of calculateInputSensitivity(inputs)) {
      const row = document.createElement('tr');
      const name = document.createElement('th'); name.scope = 'row'; name.className = 'py-2 pr-2 font-normal'; name.textContent = sensitivity.label;
      row.append(name);
      for (const change of [sensitivity.left, sensitivity.right]) {
        const cell = document.createElement('td'); cell.className = 'py-2 pr-2';
        const value = change === null ? null : Math.abs(change) < .0005 ? 0 : change;
        cell.textContent = value === null ? 'Unavailable' : `${value >= 0 ? '+' : ''}${value.toFixed(3)}`;
        row.append(cell);
      }
      sensitivities.append(row);
    }

    // Update Numerical DOM Output
    if (outLenL) outLenL.innerHTML = `${results.left.calculatedSpokeLength.toFixed(1)}<span class="text-lg text-titanium-500 ml-1">mm</span>`;
    if (outLenLRound) outLenLRound.innerHTML = `Nearest whole millimetre: <span class="font-bold text-titanium-100 mono-data">${Math.round(results.left.calculatedSpokeLength)} mm</span>`;
    if (outLenR) outLenR.innerHTML = `${results.right.calculatedSpokeLength.toFixed(1)}<span class="text-lg text-titanium-500 ml-1">mm</span>`;
    if (outLenRRound) outLenRRound.innerHTML = `Nearest whole millimetre: <span class="font-bold text-titanium-100 mono-data">${Math.round(results.right.calculatedSpokeLength)} mm</span>`;

    for (const [length, rounded] of [[outLenL, outLenLRound], [outLenR, outLenRRound]] as const) {
      if (!wheelGeometryValid(inputs, results)) {
        length.textContent = 'Unavailable'; rounded.textContent = 'Check wheel geometry';
      }
    }

    // Warn when an effective flange distance is invalid (<= 0)
    if (weffWarning) {
      const sides = [
        { name: leftLabel, valid: results.left.effectiveFlangeDistanceValid, w: results.left.effectiveFlangeDistance },
        { name: rightLabel, valid: results.right.effectiveFlangeDistanceValid, w: results.right.effectiveFlangeDistance },
      ].filter(s => !s.valid);
      if (sides.length > 0) {
        const detail = sides.map(s => `${s.name}: ${s.w.toFixed(1)} mm`).join(' · ');
        weffWarning.textContent = `⚠ Effective flange distance invalid for ${detail}. Reduce rim/hub offsets to obtain a positive value.`;
        weffWarning.classList.remove('hidden');
      } else {
        weffWarning.classList.add('hidden');
      }
    }

    if (outWeffL) outWeffL.textContent = `${results.left.effectiveFlangeDistance.toFixed(1)} mm`;
    if (outWeffR) outWeffR.textContent = `${results.right.effectiveFlangeDistance.toFixed(1)} mm`;

    if (outBracingL) outBracingL.textContent = `${results.left.bracingAngle.toFixed(1)}°`;
    if (outBracingR) outBracingR.textContent = `${results.right.bracingAngle.toFixed(1)}°`;

    if (outWrapL) outWrapL.textContent = `${results.left.wrapAngleAtRim.toFixed(1)}°`;
    if (outWrapR) outWrapR.textContent = `${results.right.wrapAngleAtRim.toFixed(1)}°`;

    if (outTotL) outTotL.textContent = `${results.left.totalAngleAtRim.toFixed(1)}°`;
    if (outTotR) outTotR.textContent = `${results.right.totalAngleAtRim.toFixed(1)}°`;

    if (outExitL) outExitL.textContent = `${results.left.flangeExitAngle.toFixed(1)}°`;
    if (outExitR) outExitR.textContent = `${results.right.flangeExitAngle.toFixed(1)}°`;

    if (outThetaL) outThetaL.textContent = `${results.left.thetaAngle.toFixed(1)}°`;
    if (outThetaR) outThetaR.textContent = `${results.right.thetaAngle.toFixed(1)}°`;

    // Derived Hub Specs
    const totalFlange = inputs.centerToLeft + inputs.centerToRight;
    const ratio = inputs.centerToLeft > 0 ? (inputs.centerToRight / inputs.centerToLeft) : 0;
    const pcdDiff = Math.abs(inputs.flangePcdLeft - inputs.flangePcdRight);

    if (hubTotalFlange) hubTotalFlange.textContent = `${totalFlange.toFixed(1)} mm`;
    if (hubFlangeRatio) hubFlangeRatio.textContent = `${ratio.toFixed(2)}`;
    if (hubPcdDiff) hubPcdDiff.textContent = `${pcdDiff.toFixed(1)} mm`;

    // Derived Rim Specs
    const rad = inputs.erd / 2;
    const circ = Math.PI * inputs.erd;
    if (rimRadius) rimRadius.textContent = `${rad.toFixed(1)} mm`;
    if (rimCircumference) rimCircumference.textContent = `${circ.toFixed(1)} mm`;
    if (rimNetShift) rimNetShift.textContent = `${inputs.osb.toFixed(1)} mm (${inputs.rimFlip})`;

    // Tension Balance Meters
    const tL = results.tensionRatioLeft;
    const tR = results.tensionRatioRight;
    if (tensionRatioLabel) tensionRatioLabel.textContent = results.tensionRatioValid ? `${tL.toFixed(1)} % : ${tR.toFixed(1)} %` : 'Unavailable';
    
    if (barPctL) barPctL.textContent = results.tensionRatioValid ? `${tL.toFixed(1)}%` : 'Unavailable';
    if (barPctR) barPctR.textContent = results.tensionRatioValid ? `${tR.toFixed(1)}%` : 'Unavailable';

    if (barFillL) barFillL.style.width = results.tensionRatioValid ? `${tL}%` : '0%';
    if (barFillR) barFillR.style.width = results.tensionRatioValid ? `${tR}%` : '0%';

    // Selected Preset Names & Summary Card Synchronizer
    const hubOpt = hubPreset.options[hubPreset.selectedIndex];
    const hubBrand = hubOpt?.getAttribute('data-brand') || '';
    const hubName = hubOpt?.getAttribute('data-name') || 'Custom Hub';
    const hubSpacing = hubOpt?.getAttribute('data-spacing') || customHubSpacing;

    const rimOpt = rimPreset.options[rimPreset.selectedIndex];
    const rimNotes = document.getElementById('rim-notes');
    if (rimNotes) rimNotes.textContent = rimPreset.value === 'custom' ? 'Custom geometry; rim appearance retained from the selected profile.' : (rimOpt?.dataset.notes || '');
    const rimBrand = rimOpt?.getAttribute('data-brand') || '';
    const rimName = rimOpt?.getAttribute('data-name') || 'Custom Rim';

    if (summaryHubName) {
      summaryHubName.textContent = hubPreset.value === 'custom' 
        ? `Custom Hub (dL: ${inputs.flangePcdLeft} / dR: ${inputs.flangePcdRight})` 
        : `${hubBrand} ${hubName}`;
    }
    if (summaryRimName) {
      summaryRimName.textContent = rimPreset.value === 'custom' 
        ? `Custom Rim (ERD: ${inputs.erd}mm)` 
        : `${rimBrand} ${rimName}`;
    }

    // 1. Update 2D CAD Hub Visualizer
    if (hubCad) {
      hubCad.updateData({
        flangePcdLeft: inputs.flangePcdLeft,
        flangePcdRight: inputs.flangePcdRight,
        centerToLeft: inputs.centerToLeft,
        centerToRight: inputs.centerToRight,
        spokeHoleDiameter: inputs.spokeHoleDiameter,
        flangeThickness: inputs.flangeThickness,
        flangeThicknessLeft: inputs.flangeThicknessLeft, flangeThicknessRight: inputs.flangeThicknessRight,
        flangeOuterDiameterLeft: Number.isFinite(inputs.flangeOuterDiameterLeft) ? inputs.flangeOuterDiameterLeft : undefined,
        flangeOuterDiameterRight: Number.isFinite(inputs.flangeOuterDiameterRight) ? inputs.flangeOuterDiameterRight : undefined,
        hubOffset: inputs.hubOffset,
        isRear: inputs.isRear, discType: inputs.discType,
        brand: hubBrand,
        name: hubName,
        spacing: hubSpacing,
      });
    }

    // 2. Update 2D CAD Rim Visualizer
    if (rimCad) {
      rimCad.updateData({
        erd: inputs.erd,
        osb: inputs.osb,
        drillingOffsetLeft: inputs.drillingOffsetLeft,
        drillingOffsetRight: inputs.drillingOffsetRight,
        rimWidthOuter: inputs.rimWidthOuter,
        rimWidthInner: inputs.rimWidthInner,
        rimDepth: inputs.rimDepth,
        ...rimAppearance,
        rimFlip: inputs.rimFlip,
        resolvedRimShift: resolveRimShift(inputs),
        isRear: inputs.isRear, discType: inputs.discType,
        brand: rimBrand,
        name: rimName,
      });
    }

    // 3. Update Three.js 3D Viewport
    if (viewport) {
      viewport.update(inputs, paths);
    }

    // 4. Update Chart
    updateCharts(results.left.bracingAngle, results.right.bracingAngle);

    // 5. Remember this tab without changing the address bar.
    saveCurrentBuild();
  }

  // 4. CHARTS UPDATES
  function updateCharts(bracingL: number, bracingR: number) {
    latestChartValues = [bracingL, bracingR];

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [bracingL, bracingR];
      chartInstance.update();
    }
