            <button id="btn-lacing-complete" class="px-2.5 py-1.5 bg-emerald-950/30 border border-emerald-500/20 hover:border-emerald-500/50 text-emerald-400 text-[10px] font-bold rounded-lg transition-all flex items-center justify-center gap-1">
