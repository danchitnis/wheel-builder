<script>
  import { type LacingSnapshot, type LacingTarget } from '../utils/lacingGuide';
  import { lacingSetupDiagram, lacingSpokeDiagram } from '../utils/lacingSetupDiagram';
  import { calculateSpokePaths } from '../utils/spokePath';
  import { initializeNippleFitPanel, readNippleFitSettings } from './nippleFitController';
  import { fitNumericFields } from '../utils/nippleFit';
  const nippleFitPanel = initializeNippleFitPanel(() => updateAll());
  import { defaultHub } from '../data/hubs';
  import { calculateWheelBuild, resolveRimShift, wheelGeometryValid } from '../utils/physicsCalculator';
  import { calculateInputSensitivity } from '../utils/inputSensitivity';
  import { wheelSideLabel } from '../utils/wheelSide';
  import type { Viewport3D as Viewport3DInstance } from './Viewport3D';
  import type { HubCadVisualizer as HubCadVisualizerInstance } from './HubCadVisualizer';
  import type { RimCadVisualizer as RimCadVisualizerInstance } from './RimCadVisualizer';
  import type { BracingChartInstance } from './BracingChart';
  import { defaultRim, type RimAppearance } from '../data/rims';
  import { numericFields, serializeConfiguration, parseConfiguration, restoreConfiguration, saveConfiguration, type BuildConfiguration, type NumericField } from '../utils/buildConfiguration';

  let rimAppearance: RimAppearance = { rimProfile: defaultRim.rimProfile, rimEyelets: defaultRim.rimEyelets, rimValveDiameter: defaultRim.rimValveDiameter };

  function readRimAppearance() {
    const option = rimPreset.options[rimPreset.selectedIndex];
    rimAppearance = {
      rimProfile: option?.dataset.profile === 'shallow-double-wall' ? 'shallow-double-wall' : 'standard',
      rimEyelets: option?.dataset.eyelets === 'true',
      rimValveDiameter: Number(option?.dataset.valve) || 6.5,
    };
  }

  let viewport: Viewport3DInstance | null = null;
  let hubCad: HubCadVisualizerInstance | null = null;
  let rimCad: RimCadVisualizerInstance | null = null;
  let chartInstance: BracingChartInstance | null = null;
  let viewportLoad: Promise<void> | null = null;
  let hubCadLoad: Promise<void> | null = null;
  let rimCadLoad: Promise<void> | null = null;
  let chartLoad: Promise<void> | null = null;
  let latestChartValues: [number, number] | null = null;

  // DOM Elements - Tabs
  const btnTabAssembly = document.getElementById('btn-tab-assembly') as HTMLButtonElement;
  const btnTabLacing = document.getElementById('btn-tab-lacing') as HTMLButtonElement;
  const btnTabHub = document.getElementById('btn-tab-hub') as HTMLButtonElement;
  const btnTabRim = document.getElementById('btn-tab-rim') as HTMLButtonElement;
  const btnTabNipple = document.getElementById('btn-tab-nipple') as HTMLButtonElement;

  const paneAssembly = document.getElementById('tab-content-assembly') as HTMLElement;
  const paneLacing = document.getElementById('tab-content-lacing') as HTMLElement;
  const paneHub = document.getElementById('tab-content-hub') as HTMLElement;
  const paneRim = document.getElementById('tab-content-rim') as HTMLElement;
  const paneNipple = document.getElementById('tab-content-nipple') as HTMLElement;

  const assemblyViewportHost = document.getElementById('assembly-viewport-host') as HTMLElement;
  const lacingViewportHost = document.getElementById('lacing-viewport-host') as HTMLElement;

  // DOM Elements - Lacing Tab Controls
  const lacingSpokeCounter = document.getElementById('lacing-spoke-counter') as HTMLElement;
  const lacingPercentLabel = document.getElementById('lacing-percent-label') as HTMLElement;
  const barOverallLacing = document.getElementById('bar-overall-lacing') as HTMLProgressElement;

  const badgeG1Count = document.getElementById('badge-g1-count') as HTMLElement;
  const badgeG2Count = document.getElementById('badge-g2-count') as HTMLElement;
  const badgeG3Count = document.getElementById('badge-g3-count') as HTMLElement;
  const badgeG4Count = document.getElementById('badge-g4-count') as HTMLElement;

  const btnPrevSpoke = document.getElementById('btn-prev-spoke') as HTMLButtonElement;
  const btnNextSpoke = document.getElementById('btn-next-spoke') as HTMLButtonElement;
  const btnPrevGroup = document.getElementById('btn-prev-group') as HTMLButtonElement;
  const btnNextGroup = document.getElementById('btn-next-group') as HTMLButtonElement;
  const btnLacingReset = document.getElementById('btn-lacing-reset') as HTMLButtonElement;
  const btnLacingComplete = document.getElementById('btn-lacing-complete') as HTMLButtonElement;

  const btnCamFixed = document.getElementById('btn-cam-fixed') as HTMLButtonElement;
  const btnCamAutotrack = document.getElementById('btn-cam-autotrack') as HTMLButtonElement;

  const lacingSpokeTitle = document.getElementById('lacing-spoke-title') as HTMLElement;
  const lacingSpokeSideBadge = document.getElementById('lacing-spoke-side-badge') as HTMLElement;
  const lacingFlangeHoleText = document.getElementById('lacing-flange-hole-text') as HTMLElement;
  const lacingHeadsDirText = document.getElementById('lacing-heads-dir-text') as HTMLElement;
  const lacingRimHoleText = document.getElementById('lacing-rim-hole-text') as HTMLElement;
  const lacingSpokeLengthText = document.getElementById('lacing-spoke-length-text') as HTMLElement;
  const lacingRuleTipText = document.getElementById('lacing-rule-tip-text') as HTMLElement;

  // DOM Elements - Presets
  const rimPreset = document.getElementById('rim-preset') as HTMLSelectElement;
  const hubPreset = document.getElementById('hub-preset') as HTMLSelectElement;

  // DOM Elements - Summary Badges
  const summaryHubName = document.getElementById('summary-hub-name') as HTMLElement;
  const summaryRimName = document.getElementById('summary-rim-name') as HTMLElement;
  const btnEditHub = document.getElementById('btn-edit-hub') as HTMLButtonElement;
  const btnEditRim = document.getElementById('btn-edit-rim') as HTMLButtonElement;

  // DOM Elements - Inputs
  const erdIn = document.getElementById('input-erd') as HTMLInputElement;
  const woIn = document.getElementById('input-rim-wo') as HTMLInputElement;
  const wiIn = document.getElementById('input-rim-wi') as HTMLInputElement;
  const depIn = document.getElementById('input-rim-dep') as HTMLInputElement;
  const osbIn = document.getElementById('input-osb') as HTMLInputElement;
  const olIn = document.getElementById('input-ol') as HTMLInputElement;
  const orIn = document.getElementById('input-or') as HTMLInputElement;

  const pcdlIn = document.getElementById('input-pcdl') as HTMLInputElement;
  const pcdrIn = document.getElementById('input-pcdr') as HTMLInputElement;
  const wlIn = document.getElementById('input-wl') as HTMLInputElement;
  const wrIn = document.getElementById('input-wr') as HTMLInputElement;
  const shIn = document.getElementById('input-sh') as HTMLInputElement;
  const odlIn = document.getElementById('input-odl') as HTMLInputElement;
  const odrIn = document.getElementById('input-odr') as HTMLInputElement;
  const ftlIn = document.getElementById('input-ftl') as HTMLInputElement;
  const ftrIn = document.getElementById('input-ftr') as HTMLInputElement;
  const sdIn = document.getElementById('input-sd') as HTMLInputElement;
  const extraHope = document.getElementById('extra-hope') as HTMLInputElement;
  let interlaced = false;
  let customHubType = 'Rear';
  let customHubSpacing = '135mm';
  let customHubDisc: '6-Bolt' | 'Centerlock' | 'None' = '6-Bolt';
  let geometryProvenance = defaultHub.geometryProvenance ?? 'Manual geometry';
  const numeric = (field: HTMLInputElement | HTMLSelectElement) => field.value.trim() === '' ? NaN : Number(field.value);
  function syncHubControls() {
    const option = hubPreset.selectedOptions[0];
    const fixedCount = option?.dataset.count;
    countIn.disabled = Boolean(fixedCount);
    if (fixedCount) countIn.value = fixedCount;
    const extraSelected = option?.dataset.extra === 'true';
    if (extraSelected) extraHope.checked = true;
    for (const opt of hubPreset.options) opt.hidden = opt.dataset.extra === 'true' && !extraHope.checked;
    document.getElementById('hub-count-note')!.textContent = fixedCount ? 'This preset uses 32 spokes. Select Custom for other counts.' : 'Custom and other hubs allow adjustable spoke counts.';
    const sources = document.getElementById('hub-sources')!;
    sources.replaceChildren();
    for (const [key, label] of [['source', 'Hope dimension chart'], ['exploded', 'Exploded diagram']]) {
      const url = option?.dataset[key];
      if (url) { const link = document.createElement('a'); link.href = url; link.textContent = label; link.target = '_blank'; link.rel = 'noopener noreferrer'; sources.append(link); }
    }
    document.getElementById('geometry-provenance')!.textContent = geometryProvenance;
  }
  extraHope.addEventListener('change', syncHubControls);
